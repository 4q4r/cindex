CINDEX_ENV=production
CINDEX_HTTP_ADDR=127.0.0.1:8001
CINDEX_SHUTDOWN_TIMEOUT=10s
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db:5432/cindex
REDIS_URL=redis://redis:6379/0
CINDEX_ARTICLES_DIR=var/articles
CINDEX_ADMIN_API_KEY=
# Owner used for bind-mounted frontend build artifacts.
CINDEX_HOST_UID=1000
CINDEX_HOST_GID=1000

# Search defaults
CINDEX_SEARCH_DEFAULT_FRESHNESS_DAYS=14
CINDEX_SEARCH_FINAL_TOP_K=30
CINDEX_SEARCH_RATE_LIMIT_PER_IP=10
CINDEX_SEARCH_RATE_LIMIT_WINDOW=60s

# Source credentials and polite-pool identifiers
CORE_API_KEY=
EXA_API_KEY=
CROSSREF_MAILTO=
OPENALEX_API_KEY=
# Required to enable Unpaywall discovery; Europe PMC remains available when blank.
UNPAYWALL_EMAIL=
# Browser sidecar (cloakbrowser Chromium) for HTML connectors. In docker
# compose this is the internal service hostname; override for local dev.
CINDEX_BROWSER_URL=http://browser:8081

# Perelman LLM quote-extraction (OpenAI-compatible chat-completions endpoint).
# All three values enable new extraction. With all three blank, the worker reads
# completed cache entries only. Partial configuration logs a warning. There is
# no hardcoded provider or fabricated fallback.
CINDEX_LLM_BASE_URL=
CINDEX_LLM_API_KEY=
CINDEX_LLM_MODEL=
# Optional provider-specific extensions merged into the chat-completions body
# (e.g. {"thinking":{"type":"enabled","budget_tokens":2048}} or
# {"provider":{"order":["openai","anthropic"]}}). Override wins on collision.
CINDEX_LLM_EXTRA_BODY={}
# Optional tuning
CINDEX_LLM_TIMEOUT=120
CINDEX_LLM_TEMPERATURE=0.2
CINDEX_LLM_MAX_QUOTES=3
CINDEX_LLM_CONCURRENCY=4
# Minimum gap (seconds) between successive LLM request *starts*, enforced
# client-side by OpenAICompatibleClient on a monotonic clock on top of the
# concurrency semaphore. 0 disables it. Some OpenAI-compatible providers
# throttle by request frequency (~1 QPS) on top of concurrency — e.g. Z.AI's
# free tier, which is effectively 1 concurrent request + ~1 QPS, so set
# CONCURRENCY=1 and MIN_REQUEST_INTERVAL=1.0 there to avoid 429s.
CINDEX_LLM_MIN_REQUEST_INTERVAL=0
CINDEX_LLM_MAX_INPUT_CHARS=12000
# Multimodal PERELMAN controls. PDF pages and HTML screenshots are sent as
# image payloads; the model can inspect them with bounded image tools.
CINDEX_LLM_MAX_TOOL_TURNS=6
CINDEX_LLM_MAX_PDF_PAGES=8
CINDEX_LLM_PDF_DPI=144
CINDEX_LLM_MAX_IMAGES=8
CINDEX_LLM_IMAGE_DETAIL=high
CINDEX_LLM_MAX_IMAGE_DIM=4096
