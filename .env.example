DEBUG=false
SECRET_KEY=replace-with-long-random-secret
ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_PASSWORD=replace-me
DATABASE_URL=postgresql://postgres:replace-me@db:5432/cindex
REDIS_URL=redis://redis:6379/0
EXA_API_KEY=replace-with-exa-api-key
CROSSREF_MAILTO=
OPENALEX_API_KEY=
# Browser sidecar (cloakbrowser Chromium) for HTML connectors. In docker
# compose this is the internal service hostname; override for local dev.
CINDEX_BROWSER_URL=http://browser:8081

# Perelman LLM quote-extraction (OpenAI-compatible chat-completions endpoint).
# Required for quote extraction; if any of BASE_URL/API_KEY/MODEL is unset, the
# pipeline logs one warning and results fall back to the abstract preview
# (quotes empty) — there is no hardcoded provider or fake fallback.
CINDEX_LLM_BASE_URL=
CINDEX_LLM_API_KEY=
CINDEX_LLM_MODEL=
# Optional provider-specific extensions merged into the chat-completions body
# (e.g. {"thinking":{"type":"enabled","budget_tokens":2048}} or
# {"provider":{"order":["openai","anthropic"]}}). Override wins on collision.
CINDEX_LLM_EXTRA_BODY={}
# Optional tuning
CINDEX_LLM_TIMEOUT=120
CINDEX_LLM_TEMPERATURE=0.2
CINDEX_LLM_MAX_QUOTES=3
CINDEX_LLM_CONCURRENCY=4
# Minimum gap (seconds) between successive LLM request *starts*, enforced
# client-side by OpenAICompatibleClient on a monotonic clock on top of the
# concurrency semaphore. 0 disables it. Some OpenAI-compatible providers
# throttle by request frequency (~1 QPS) on top of concurrency — e.g. Z.AI's
# free tier, which is effectively 1 concurrent request + ~1 QPS, so set
# CONCURRENCY=1 and MIN_REQUEST_INTERVAL=1.0 there to avoid 429s.
CINDEX_LLM_MIN_REQUEST_INTERVAL=0
CINDEX_LLM_MAX_INPUT_CHARS=12000
# Multimodal / vision. PERELMAN receives rendered PDF pages, a full-page
# screenshot, and/or figure images, and uses zoom/crop/rotate tools to inspect
# small regions. Raise TIMEOUT for vision (large image payloads). PDF is
# rasterized at PDF_DPI; MAX_PDF_PAGES caps how many pages are sent. MAX_IMAGES
# caps the figure count atop the screenshot. MAX_IMAGE_DIM downscales the long
# side for token economy; IMAGE_QUALITY is the JPEG re-encode quality.
# MAX_TOOL_TURNS guards the agent loop. IMAGE_DETAIL is the OpenAI image_url
# detail: low|high|auto.
CINDEX_LLM_PDF_DPI=200
CINDEX_LLM_MAX_PDF_PAGES=8
CINDEX_LLM_MAX_IMAGES=6
CINDEX_LLM_MAX_IMAGE_DIM=2000
CINDEX_LLM_IMAGE_QUALITY=85
CINDEX_LLM_MAX_TOOL_TURNS=6
CINDEX_LLM_IMAGE_DETAIL=high
# Local markdown store for PERELMAN-processed articles (published only).
# Processed articles are frozen: on refresh the pipeline reads the local md
# first and skips re-fetching from the network. Bind-mount this dir in
# docker-compose so the .md files survive container rebuilds.
CINDEX_ARTICLES_DIR=var/articles
