from __future__ import annotations

import base64
import hashlib
import json
import os
import re
import time
import uuid
from dataclasses import dataclass, replace
from datetime import UTC, datetime
from urllib.parse import quote_plus, urljoin, urlparse
from xml.etree import ElementTree as ET

import cloudscraper
import httpx
import pymupdf
from browserforge.headers import Browser, HeaderGenerator
from bs4 import BeautifulSoup
from websockets.exceptions import ConnectionClosed
from websockets.sync.client import connect

from apps.core.text import normalize_scholarly_text

DOI_PATTERN = re.compile(r"10\.\d{4,9}/[-._;()/:A-Z0-9]+", re.IGNORECASE)
YEAR_PATTERN = re.compile(r"(?:19|20)\d{2}")
PDF_URL_PATTERN = re.compile(
    r"https?://[^\s\"'<>]+?\.pdf(?:\?[^\s\"'<>]+)?",
    re.IGNORECASE,
)
OCR_LANGUAGE_MAP: dict[str, str] = {
    "ar": "ara",
    "de": "deu",
    "en": "eng",
    "eng": "eng",
    "es": "spa",
    "fr": "fra",
    "it": "ita",
    "ja": "jpn",
    "jpn": "jpn",
    "ko": "kor",
    "kor": "kor",
    "pt": "por",
    "ru": "rus",
    "rus": "rus",
    "zh": "chi_sim+chi_tra",
    "zho": "chi_sim+chi_tra",
}
HTML_BOILERPLATE_TAGS = (
    "script",
    "style",
    "noscript",
    "template",
    "svg",
    "canvas",
    "iframe",
)


class ConnectorFetchError(Exception):
    """Raised when source content is blocked, invalid, or unavailable."""


@dataclass(frozen=True)
class SourceProfile:
    """Source Profile class."""

    source_key: str
    search_url: str
    mode: str = "html"
    query_param: str = "q"
    result_selector: str = "article, .result, .search-result, li, .item"
    link_selector: str = "a[href]"
    title_selector: str = "h1, h2, h3, .title, .article-title, a[href]"
    abstract_selector: str = ".abstract, .summary, p"
    journal_selector: str = ".journal, .source, .pub, .citation"
    peer_review_evidence: str = "peer reviewed"
    indexing_evidence: str = "scopus web of science"
    preprint_evidence: str = "journal article"
    language: str = "en"


@dataclass
class RawArticle:
    """Raw Article class."""

    source_key: str
    title: str
    url: str
    abstract: str
    full_text: str
    language: str
    year: int | None
    doi: str
    journal: str
    authors: tuple[str, ...] = ()
    volume: str = ""
    issue: str = ""
    pages: str = ""
    peer_review_evidence: str = ""
    indexing_evidence: str = ""
    preprint_evidence: str = ""


class BaseConnector:
    """Base source connector."""

    profile: SourceProfile
    REQUEST_TIMEOUT_SECONDS = 25
    MAX_ATTEMPTS = 3
    _header_generator: HeaderGenerator | None = None
    PEER_REVIEW_TOKENS = (
        "peer reviewed",
        "peer-review",
        "refereed",
        "double blind review",
    )
    INDEXING_TOKENS = (
        "scopus",
        "web of science",
        "medline",
        "pmc",
        "pubmed central",
        "kci",
        "tr dizin",
        "doaj",
    )
    PREPRINT_TOKENS = (
        "preprint",
        "author manuscript",
        "accepted manuscript",
        "working paper",
    )

    def fetch(self, query: str, limit: int = 5) -> list[RawArticle]:
        """Fetch records from the upstream source."""
        if self.profile.mode == "api":
            return self._fetch_api(query, limit)
        if self.profile.mode == "ws":
            return self._fetch_ws(query, limit)
        return self._fetch_html(query, limit)

    def enrich_raw(self, raw: RawArticle) -> RawArticle:
        """Enrich the raw source payload with parsed metadata."""
        if not raw.url.startswith("http"):
            return raw
        try:
            html = self._request_text(
                raw.url,
                ocr_language=self._ocr_language(raw.language),
            )
            soup = self._sanitize_html_soup(BeautifulSoup(html, "lxml"))
        except Exception:
            return raw

        meta_text = normalize_scholarly_text(
            self._extract_meta_text(soup), max_length=12000
        )
        body_text = self._html_text(soup)
        page_sample = body_text[:20000]
        combined_page_text = " ".join([meta_text, page_sample])
        if self._looks_like_challenge_page(combined_page_text):
            raise ConnectorFetchError(
                f"{self.profile.source_key}: challenge page returned for"
                " article landing page"
            )

        pdf_url = self._extract_pdf_url(
            soup, raw.url, raw.full_text, combined_page_text
        )
        pdf_text = ""
        if pdf_url and pdf_url != raw.url:
            try:
                pdf_text = self._request_pdf_text(
                    pdf_url,
                    ocr_language=self._ocr_language(raw.language),
                )
            except Exception:
                pdf_text = ""

        doi = raw.doi or self._extract_doi(" ".join([combined_page_text, pdf_text]))
        year = raw.year or self._extract_year(" ".join([combined_page_text, pdf_text]))
        journal = raw.journal
        if journal.upper() == raw.source_key.upper():
            journal = (
                self._extract_meta_content(
                    soup,
                    [
                        "citation_journal_title",
                        "dc.source",
                        "dc.Source",
                        "prism.publicationname",
                        "og:site_name",
                    ],
                )
                or journal
            )
        abstract = normalize_scholarly_text(
            raw.abstract
            or self._extract_meta_content(
                soup,
                [
                    "citation_abstract",
                    "description",
                    "dc.description",
                    "og:description",
                ],
            ),
            max_length=8000,
        )

        peer_review_evidence = self._merge_evidence(
            raw.peer_review_evidence,
            combined_page_text,
            self.PEER_REVIEW_TOKENS,
        )
        indexing_evidence = self._merge_evidence(
            raw.indexing_evidence,
            combined_page_text,
            self.INDEXING_TOKENS,
        )
        preprint_evidence = self._merge_evidence(
            raw.preprint_evidence,
            " ".join([combined_page_text, pdf_text]),
            self.PREPRINT_TOKENS,
        )
        source_text = pdf_text or body_text
        if source_text or raw.doi:
            try:
                from apps.ingestion.fulltext_resolver import LawfulFullTextResolver

                source_text = LawfulFullTextResolver(self).resolve(
                    raw,
                    existing_text=source_text,
                )
            except Exception:
                pass
        if source_text:
            full_text = normalize_scholarly_text(
                " ".join([raw.title, source_text]),
            )
        else:
            full_text = normalize_scholarly_text(
                " ".join([raw.full_text, page_sample]),
            )
        return replace(
            raw,
            doi=doi,
            year=year,
            journal=normalize_scholarly_text(journal, max_length=300),
            abstract=(abstract or "")[:8000],
            full_text=full_text,
            peer_review_evidence=peer_review_evidence[:3000],
            indexing_evidence=indexing_evidence[:3000],
            preprint_evidence=preprint_evidence[:3000],
        )

    @staticmethod
    def _build_scraper() -> cloudscraper.CloudScraper:
        """Build scraper."""
        kwargs: dict = {
            "interpreter": "js2py",
            "browser": {"browser": "chrome", "platform": "linux", "mobile": False},
            "delay": 8,
        }
        captcha_provider = os.getenv("CLOUDSCRAPER_CAPTCHA_PROVIDER", "").strip()
        captcha_key = os.getenv("CLOUDSCRAPER_CAPTCHA_API_KEY", "").strip()
        if captcha_provider and captcha_key:
            kwargs["captcha"] = {
                "provider": captcha_provider,
                "api_key": captcha_key,
            }
        return cloudscraper.create_scraper(**kwargs)

    @classmethod
    def _get_header_generator(cls) -> HeaderGenerator:
        """Return header generator."""
        if cls._header_generator is None:
            cls._header_generator = HeaderGenerator(
                browser=[
                    Browser(name="chrome", min_version=120),
                    Browser(name="firefox", min_version=120),
                    Browser(name="edge", min_version=120),
                ]
            )
        return cls._header_generator

    @classmethod
    def _generate_headers(cls) -> dict[str, str]:
        """Generate headers."""
        generated = cls._get_header_generator().generate()
        headers = {str(k): str(v) for k, v in generated.items()}
        headers.setdefault("Cache-Control", "no-cache")
        headers.setdefault("Pragma", "no-cache")
        return headers

    @staticmethod
    def _looks_like_challenge_page(text: str) -> bool:
        """Looks like challenge page."""
        lowered = (text or "").lower()
        markers = (
            "just a moment...",
            "cf_chl_opt",
            "cdn-cgi/challenge-platform",
            "verify you are human",
            "enable javascript and cookies to continue",
            "making sure you're not a bot",
            "protected by anubis",
            "anubis uses a proof-of-work",
            "proof-of-work scheme",
        )
        return any(marker in lowered for marker in markers)

    def _challenge_retry(
        self,
        scraper: cloudscraper.CloudScraper,
        url: str,
        params: dict[str, str] | None,
    ) -> str | None:
        """Challenge retry."""
        try:
            tokens, user_agent = cloudscraper.get_tokens(
                url,
                browser={"browser": "chrome", "platform": "linux", "mobile": False},
            )
            headers = self._generate_headers()
            headers["User-Agent"] = user_agent
            headers = {
                **headers,
                "Referer": url,
            }
            response = scraper.get(
                url,
                params=params,
                headers=headers,
                cookies=tokens,
                timeout=self.REQUEST_TIMEOUT_SECONDS,
            )
            if int(response.status_code) >= 400:
                return None
            return response.text
        except Exception:  # pragma: no cover - network dependent
            return None

    def _challenge_retry_cookie_string(
        self,
        scraper: cloudscraper.CloudScraper,
        url: str,
        params: dict[str, str] | None,
    ) -> str | None:
        """Challenge retry cookie string."""
        try:
            generated_headers = self._generate_headers()
            cookie_header, user_agent = cloudscraper.get_cookie_string(
                url,
                user_agent=generated_headers.get("User-Agent"),
            )
            headers = {
                **generated_headers,
                "User-Agent": user_agent,
                "Referer": url,
                "Cookie": cookie_header,
            }
            response = scraper.get(
                url,
                params=params,
                headers=headers,
                timeout=self.REQUEST_TIMEOUT_SECONDS,
            )
            if int(response.status_code) >= 400:
                return None
            return response.text
        except Exception:  # pragma: no cover - network dependent
            return None

    def _request_response(
        self,
        url: str,
        params: dict[str, str] | None = None,
        accept: str | None = None,
    ) -> tuple[cloudscraper.CloudScraper, object, str]:
        """Send a request for response."""
        scraper = self._build_scraper()
        last_error: Exception | None = None
        for attempt in range(1, self.MAX_ATTEMPTS + 1):
            try:
                headers = self._generate_headers()
                if accept:
                    headers.setdefault("Accept", accept)
                response = scraper.get(
                    url,
                    params=params,
                    headers=headers,
                    timeout=self.REQUEST_TIMEOUT_SECONDS,
                )
                status = int(response.status_code)
                body = response.text
                if status == 403 or self._looks_like_challenge_page(body):
                    solved = self._challenge_retry(scraper, url, params)
                    if not solved:
                        solved = self._challenge_retry_cookie_string(
                            scraper, url, params
                        )
                    if solved:
                        body = solved
                        status = 200
                if status >= 400:
                    raise ConnectorFetchError(
                        f"{self.profile.source_key}: http {status}"
                    )
                if self._looks_like_challenge_page(body):
                    raise ConnectorFetchError(
                        f"{self.profile.source_key}: cloudflare challenge unresolved"
                    )
                return scraper, response, body
            except Exception as exc:  # pragma: no cover - network dependent
                last_error = exc
                if attempt < self.MAX_ATTEMPTS:
                    time.sleep(0.6 * attempt)
        raise ConnectorFetchError(
            f"{self.profile.source_key}: request failed after retries: {last_error}"
        )

    @staticmethod
    def _is_pdf_response(url: str, content_type: str, body: bytes) -> bool:
        """Return whether PDF response."""
        content_type_lower = content_type.lower()
        url_lower = url.lower()
        return (
            url_lower.endswith(".pdf")
            or "application/pdf" in content_type_lower
            or body.startswith(b"%PDF")
        )

    @staticmethod
    def _extract_pdf_text(pdf_bytes: bytes) -> str:
        """Extract PDF text."""
        return BaseConnector._extract_pdf_text_with_language(
            pdf_bytes,
            ocr_language="eng",
        )

    @staticmethod
    def _extract_pdf_text_with_language(
        pdf_bytes: bytes,
        *,
        ocr_language: str,
    ) -> str:
        """Extract PDF text with an OCR language hint."""

        try:
            document = pymupdf.open(stream=pdf_bytes, filetype="pdf")
        except Exception:
            return ""
        parts: list[str] = []
        for page in document:
            try:
                page_text = page.get_text("text", sort=True).strip()
            except Exception:
                page_text = ""
            if not page_text or "\ufffd" in page_text:
                try:
                    page_text = page.get_textpage_ocr(language=ocr_language)
                    page_text = page.get_text(textpage=page_text).strip()
                except Exception:
                    page_text = ""
            if page_text:
                parts.append(page_text)
        return normalize_scholarly_text(" ".join(parts))

    @staticmethod
    def _ocr_language(language: str) -> str:
        """Map a source language to a Tesseract OCR language code."""

        normalized = normalize_scholarly_text(language).lower().strip()
        if not normalized:
            return "eng"
        return OCR_LANGUAGE_MAP.get(
            normalized, OCR_LANGUAGE_MAP.get(normalized[:2], "eng")
        )

    def _request_text(
        self,
        url: str,
        params: dict[str, str] | None = None,
        *,
        ocr_language: str = "eng",
    ) -> str:
        """Send a request for text."""
        _, response, body_text = self._request_response(url, params=params)
        content_type = str(response.headers.get("Content-Type", ""))
        body_bytes = bytes(response.content or b"")
        if self._is_pdf_response(url, content_type, body_bytes):
            pdf_text = self._extract_pdf_text_with_language(
                body_bytes,
                ocr_language=ocr_language,
            )
            return pdf_text
        return body_text

    def _request_pdf_text(
        self,
        url: str,
        *,
        ocr_language: str = "eng",
    ) -> str:
        """Fetch a PDF resource and extract its textual content."""

        _, response, body_text = self._request_response(
            url,
            params=None,
            accept="application/pdf,*/*",
        )
        content_type = str(response.headers.get("Content-Type", ""))
        body_bytes = bytes(response.content or b"")
        if self._is_pdf_response(url, content_type, body_bytes):
            pdf_text = self._extract_pdf_text_with_language(
                body_bytes,
                ocr_language=ocr_language,
            )
            return pdf_text
        if body_text:
            return normalize_scholarly_text(body_text)
        return ""

    def _request_json(self, url: str) -> dict:
        """Send a request for JSON."""
        last_error: Exception | None = None
        for attempt in range(1, self.MAX_ATTEMPTS + 1):
            try:
                _, _, body = self._request_response(
                    url,
                    params=None,
                    accept="application/json,text/plain,*/*",
                )
                payload = json.loads(body)
                if not isinstance(payload, dict):
                    raise ConnectorFetchError(
                        f"{self.profile.source_key}: invalid JSON payload type"
                    )
                return payload
            except Exception as exc:  # pragma: no cover - network dependent
                last_error = exc
                if attempt < self.MAX_ATTEMPTS:
                    time.sleep(0.6 * attempt)
        raise ConnectorFetchError(
            f"{self.profile.source_key}: json request failed after retries:"
            f" {last_error}"
        )

    def _fetch_html(self, query: str, limit: int) -> list[RawArticle]:
        """Fetch HTML."""
        html = self._request_text(
            self.profile.search_url,
            params={self.profile.query_param: query},
        )
        soup = self._sanitize_html_soup(BeautifulSoup(html, "lxml"))
        self._assert_page_is_parseable(html, soup)
        return self._extract_from_html(query, soup, limit)

    def _assert_page_is_parseable(self, raw_html: str, soup: BeautifulSoup) -> None:
        """Assert page is parseable."""
        text = self._html_text(soup).lower()
        if any(marker in text for marker in ("verify you are human", "captcha")):
            raise ConnectorFetchError(
                f"{self.profile.source_key}: blocked by verification challenge"
            )
        page_title = soup.title.get_text(strip=True).lower() if soup.title else ""
        if "404" in page_title and "not found" in page_title:
            raise ConnectorFetchError(
                f"{self.profile.source_key}: search page not found"
            )
        if not raw_html.strip():
            raise ConnectorFetchError(f"{self.profile.source_key}: empty response body")

    def _fetch_api(self, query: str, limit: int) -> list[RawArticle]:
        """Fetch API."""
        payload = self._request_json(self._api_url(query, limit))
        return self._extract_from_payload(query, payload, limit)

    def _fetch_ws(self, query: str, limit: int) -> list[RawArticle]:
        """Fetch websocket source payload."""
        raise ConnectorFetchError(
            f"{self.profile.source_key}: websocket transport is not implemented"
        )

    def _api_url(self, query: str, limit: int) -> str:
        """Api url."""
        return (
            f"{self.profile.search_url}?{self.profile.query_param}={quote_plus(query)}"
            f"&pageSize={limit}"
        )

    def _extract_from_payload(
        self, query: str, payload: dict, limit: int
    ) -> list[RawArticle]:
        """Extract from payload."""
        return []

    def _extract_from_html(
        self, query: str, soup: BeautifulSoup, limit: int
    ) -> list[RawArticle]:
        """Extract from HTML."""
        rows = soup.select(self.profile.result_selector)
        items: list[RawArticle] = []
        for row in rows:
            parsed = self._build_from_row(query, row)
            if not parsed:
                continue
            items.append(parsed)
            if len(items) >= limit:
                break
        if items:
            return items
        return []

    @staticmethod
    def _sanitize_html_soup(soup: BeautifulSoup) -> BeautifulSoup:
        """Remove boilerplate tags that should not contribute to article text."""

        for tag in soup.find_all(HTML_BOILERPLATE_TAGS):
            tag.decompose()
        return soup

    @staticmethod
    def _html_text(soup: BeautifulSoup) -> str:
        """Render sanitized HTML text for article parsing."""

        return normalize_scholarly_text(" ".join(soup.stripped_strings))

    def _build_from_row(self, query: str, row) -> RawArticle | None:
        """Build from row."""
        title_node = row.select_one(self.profile.title_selector)
        link_node = row.select_one(self.profile.link_selector)
        abstract_node = row.select_one(self.profile.abstract_selector)
        journal_node = row.select_one(self.profile.journal_selector)
        if not title_node or not link_node:
            return None

        title = title_node.get_text(" ", strip=True)
        href = urljoin(self.profile.search_url, link_node.get("href", ""))
        abstract = abstract_node.get_text(" ", strip=True) if abstract_node else ""
        journal = (
            journal_node.get_text(" ", strip=True)
            if journal_node
            else self.profile.source_key.upper()
        )
        combined = " ".join([title, abstract, journal])

        doi = self._extract_doi(combined)
        year = self._extract_year(combined)

        return self._raw(
            title=title,
            url=href,
            abstract=abstract,
            full_text=combined,
            doi=doi,
            year=year,
            journal=journal,
        )

    def _raw(
        self,
        *,
        title: str,
        url: str,
        abstract: str,
        full_text: str,
        doi: str,
        year: int | None,
        journal: str,
        authors: tuple[str, ...] | list[str] | None = None,
        volume: str = "",
        issue: str = "",
        pages: str = "",
    ) -> RawArticle:
        """Raw."""
        return RawArticle(
            source_key=self.profile.source_key,
            title=normalize_scholarly_text(title, max_length=900),
            url=url,
            abstract=normalize_scholarly_text(abstract, max_length=8000),
            full_text=normalize_scholarly_text(full_text),
            language=self.profile.language,
            year=year,
            doi=normalize_scholarly_text(doi, max_length=128),
            journal=normalize_scholarly_text(journal, max_length=300),
            authors=tuple(
                item.strip()
                for item in (authors or ())
                if isinstance(item, str) and item.strip()
            ),
            volume=normalize_scholarly_text(volume, max_length=32),
            issue=normalize_scholarly_text(issue, max_length=32),
            pages=normalize_scholarly_text(pages, max_length=32),
            peer_review_evidence=self.profile.peer_review_evidence,
            indexing_evidence=self.profile.indexing_evidence,
            preprint_evidence=self.profile.preprint_evidence,
        )

    @staticmethod
    def _extract_doi(text: str) -> str:
        """Extract DOI."""
        found = DOI_PATTERN.search(text or "")
        return found.group(0) if found else ""

    @staticmethod
    def _extract_year(text: str) -> int | None:
        """Extract year."""
        found = YEAR_PATTERN.search(text or "")
        return int(found.group(0)) if found else None

    def _extract_json_ld_articles(
        self, soup: BeautifulSoup, limit: int
    ) -> list[RawArticle]:
        """Extract JSON LD articles."""
        items: list[RawArticle] = []
        for script in soup.select("script[type='application/ld+json']"):
            body = script.string or script.get_text(strip=True)
            if not body:
                continue
            try:
                payload = json.loads(body)
            except json.JSONDecodeError:
                continue
            records: list[dict] = []
            if isinstance(payload, dict):
                graph = payload.get("@graph")
                if isinstance(graph, list):
                    records.extend([x for x in graph if isinstance(x, dict)])
                records.append(payload)
            elif isinstance(payload, list):
                records.extend([x for x in payload if isinstance(x, dict)])

            for record in records:
                schema_type = str(record.get("@type", "")).lower()
                if not any(
                    token in schema_type
                    for token in ("article", "scholarlyarticle", "creativework")
                ):
                    continue
                title = str(record.get("headline") or record.get("name") or "").strip()
                url_value = str(
                    record.get("url") or record.get("mainEntityOfPage") or ""
                ).strip()
                abstract = str(record.get("description") or "").strip()
                journal_info = record.get("isPartOf")
                if isinstance(journal_info, dict):
                    journal = str(
                        journal_info.get("name") or journal_info.get("headline") or ""
                    ).strip()
                else:
                    journal = str(journal_info or "").strip()
                date_published = str(record.get("datePublished") or "")
                doi = self._extract_doi(
                    " ".join(
                        [
                            title,
                            abstract,
                            str(record.get("identifier", "")),
                            str(record.get("sameAs", "")),
                        ]
                    )
                )
                year = self._extract_year(date_published) or self._extract_year(
                    " ".join([title, abstract])
                )
                if not title or not url_value:
                    continue
                items.append(
                    self._raw(
                        title=title,
                        url=url_value,
                        abstract=abstract,
                        full_text=" ".join([title, abstract, journal]),
                        doi=doi,
                        year=year,
                        journal=journal or self.profile.source_key.upper(),
                    )
                )
                if len(items) >= limit:
                    return items
        return items

    def _extract_pdf_url(
        self,
        soup: BeautifulSoup,
        *blobs: str,
    ) -> str:
        """Extract a likely PDF URL from metadata, anchors, or raw text blobs."""

        meta_keys = (
            "citation_pdf_url",
            "citation_pdfurl",
            "dc.identifier",
            "dc.source",
            "prism.url",
            "og:url",
        )
        for key in meta_keys:
            value = self._extract_meta_content(soup, [key]).strip()
            if value.lower().endswith(".pdf") and value.startswith("http"):
                return value
        for link in soup.select("a[href]"):
            href = urljoin(self.profile.search_url, link.get("href", ""))
            label = link.get_text(" ", strip=True).lower()
            href_lower = href.lower()
            if href_lower.endswith(".pdf") or "pdf" in href_lower or "pdf" in label:
                if href.startswith("http"):
                    return href
        for blob in blobs:
            found = PDF_URL_PATTERN.search(blob or "")
            if found:
                return found.group(0)
        return ""

    @staticmethod
    def _query_tokens(query: str) -> list[str]:
        """Query tokens."""
        return [
            x.lower() for x in re.findall(r"[a-zA-Zа-яА-Я0-9]+", query) if len(x) > 2
        ]

    @staticmethod
    def _extract_meta_content(soup: BeautifulSoup, keys: list[str]) -> str:
        """Extract meta content."""
        lowered_keys = {k.lower() for k in keys}
        for meta in soup.select("meta[name], meta[property]"):
            name = (meta.get("name") or meta.get("property") or "").strip().lower()
            if name in lowered_keys:
                content = (meta.get("content") or "").strip()
                if content:
                    return content
        return ""

    @classmethod
    def _extract_meta_text(cls, soup: BeautifulSoup) -> str:
        """Extract meta text."""
        values: list[str] = []
        for meta in soup.select("meta[name], meta[property]"):
            content = (meta.get("content") or "").strip()
            if content:
                values.append(content)
        return " ".join(values)

    @staticmethod
    def _merge_evidence(base: str, page_text: str, tokens: tuple[str, ...]) -> str:
        """Merge evidence."""
        existing = (base or "").strip()
        lower_page = (page_text or "").lower()
        found = [token for token in tokens if token in lower_page]
        if not found:
            return existing
        merged = existing
        for token in found:
            if token.lower() not in merged.lower():
                merged = f"{merged} {token}".strip()
        return merged

    @staticmethod
    def _is_article_like_item(title: str, url: str, doi: str, year: int | None) -> bool:
        """Return whether article like item."""
        if not title or len(title.strip()) < 18:
            return False
        bad_title_tokens = {
            "browse",
            "advanced search",
            "journal collections",
            "home",
            "login",
            "about",
            "help",
        }
        normalized = title.strip().lower()
        if normalized in bad_title_tokens:
            return False
        if not url.startswith("http"):
            return False
        return bool(doi or year)


class EuropePMCConnector(BaseConnector):
    """Europe PMC source connector."""

    profile = SourceProfile(
        source_key="europe_pmc",
        search_url="https://www.ebi.ac.uk/europepmc/webservices/rest/search",
        mode="api",
        query_param="query",
        indexing_evidence="medline pmc",
    )

    def _api_url(self, query: str, limit: int) -> str:
        """Api url."""
        return (
            "https://www.ebi.ac.uk/europepmc/webservices/rest/search"
            f"?query={quote_plus(query)}&format=json&pageSize={limit}&resultType=core"
        )

    def _extract_from_payload(
        self, query: str, payload: dict, limit: int
    ) -> list[RawArticle]:
        """Extract from payload."""
        records = payload.get("resultList", {}).get("result", [])
        items: list[RawArticle] = []
        for rec in records[:limit]:
            title = rec.get("title", "").strip()
            abstract = rec.get("abstractText", "")
            journal = rec.get("journalTitle", "Europe PMC")
            doi = rec.get("doi", "") or self._extract_doi(" ".join([title, abstract]))
            year = rec.get("pubYear")
            url = rec.get("fullTextUrlList", {}).get("fullTextUrl", [{}])
            url_value = url[0].get("url") if url else rec.get("id", "")
            if not title or not url_value:
                continue
            items.append(
                self._raw(
                    title=title,
                    url=url_value,
                    abstract=abstract,
                    full_text=" ".join([title, abstract]),
                    doi=doi,
                    year=int(year) if str(year).isdigit() else None,
                    journal=journal,
                )
            )
        return items


class OpenAlexConnector(BaseConnector):
    """OpenAlex source connector."""

    profile = SourceProfile(
        source_key="openalex",
        search_url="https://api.openalex.org/works",
        mode="api",
        query_param="search",
        indexing_evidence="openalex crossref semantic scholar",
    )

    @staticmethod
    def _build_abstract(inverted_index: dict | None) -> str:
        """Reconstruct OpenAlex abstract text from an inverted index."""

        if not isinstance(inverted_index, dict) or not inverted_index:
            return ""
        positions: dict[int, str] = {}
        for token, indexes in inverted_index.items():
            if not isinstance(token, str) or not isinstance(indexes, list):
                continue
            for index in indexes:
                if isinstance(index, int):
                    positions[index] = token
        if not positions:
            return ""
        return " ".join(positions[index] for index in sorted(positions))

    def _api_url(self, query: str, limit: int) -> str:
        """Api url."""

        return (
            "https://api.openalex.org/works"
            f"?search={quote_plus(query)}"
            "&filter=type:article"
            f"&per-page={max(1, limit * 3)}"
            "&select=id,doi,display_name,abstract_inverted_index,"
            "publication_year,authorships,primary_location"
        )

    def _extract_from_payload(
        self, query: str, payload: dict, limit: int
    ) -> list[RawArticle]:
        """Extract from payload."""

        results = payload.get("results", [])
        items: list[RawArticle] = []
        for rec in results:
            if not isinstance(rec, dict):
                continue
            title = str(rec.get("display_name", "")).strip()
            doi = str(rec.get("doi", "")).strip()
            if doi.lower().startswith("https://doi.org/"):
                doi = doi.rsplit("/", 1)[-1]
            abstract = self._build_abstract(rec.get("abstract_inverted_index"))
            year_raw = rec.get("publication_year")
            year = int(year_raw) if str(year_raw).isdigit() else None
            authors = []
            for item in rec.get("authorships", []) or []:
                if not isinstance(item, dict):
                    continue
                author = item.get("author", {})
                if isinstance(author, dict):
                    name = str(author.get("display_name", "")).strip()
                    if name:
                        authors.append(name)
            location = rec.get("primary_location", {})
            journal = "OpenAlex"
            url_value = ""
            if isinstance(location, dict):
                source = location.get("source", {})
                if isinstance(source, dict):
                    journal = (
                        str(
                            source.get("display_name") or source.get("publisher") or ""
                        ).strip()
                        or journal
                    )
                url_value = str(location.get("landing_page_url") or "").strip()
            if not url_value:
                record_id = str(rec.get("id", "")).rsplit("/", 1)[-1]
                url_value = f"https://openalex.org/{record_id}"
            combined = " ".join([title, abstract, journal, " ".join(authors)])
            if not title or not url_value:
                continue
            if not self._is_article_like_item(title, url_value, doi, year):
                continue
            items.append(
                self._raw(
                    title=title,
                    url=url_value,
                    abstract=abstract,
                    full_text=combined,
                    doi=doi,
                    year=year,
                    journal=journal,
                    authors=tuple(authors),
                )
            )
            if len(items) >= limit:
                break
        return items


class CrossrefConnector(BaseConnector):
    """Crossref source connector."""

    profile = SourceProfile(
        source_key="crossref",
        search_url="https://api.crossref.org/works",
        mode="api",
        query_param="query.bibliographic",
        indexing_evidence="crossref openalex semantic scholar",
    )

    def _api_url(self, query: str, limit: int) -> str:
        """Api url."""

        return (
            "https://api.crossref.org/works"
            f"?query.bibliographic={quote_plus(query)}"
            "&filter=type:journal-article"
            f"&rows={max(1, limit * 3)}"
            "&select=DOI,title,abstract,container-title,author,issued,URL,type"
        )

    @staticmethod
    def _year_from_issued(record: dict) -> int | None:
        """Extract year from Crossref issued date parts."""

        date_parts = (
            record.get("issued", {})
            if isinstance(record.get("issued", {}), dict)
            else {}
        )
        parts = date_parts.get("date-parts", [])
        if not isinstance(parts, list) or not parts:
            return None
        first = parts[0]
        if not isinstance(first, list) or not first:
            return None
        year_raw = first[0]
        return int(year_raw) if str(year_raw).isdigit() else None

    def _extract_from_payload(
        self, query: str, payload: dict, limit: int
    ) -> list[RawArticle]:
        """Extract from payload."""

        records = payload.get("message", {}).get("items", [])
        items: list[RawArticle] = []
        for rec in records:
            if not isinstance(rec, dict):
                continue
            if str(rec.get("type", "")).lower() not in {
                "journal-article",
                "review-article",
            }:
                continue
            title_values = rec.get("title", [])
            title = ""
            if isinstance(title_values, list) and title_values:
                title = str(title_values[0]).strip()
            abstract = str(rec.get("abstract", "")).strip()
            doi = str(rec.get("DOI", "")).strip()
            if doi.lower().startswith("https://doi.org/"):
                doi = doi.rsplit("/", 1)[-1]
            journals = rec.get("container-title", [])
            journal = (
                str(journals[0]).strip()
                if isinstance(journals, list) and journals
                else ""
            )
            year = self._year_from_issued(rec)
            authors = []
            for author in rec.get("author", []) or []:
                if not isinstance(author, dict):
                    continue
                given = str(author.get("given", "")).strip()
                family = str(author.get("family", "")).strip()
                full_name = " ".join(part for part in [given, family] if part)
                if full_name:
                    authors.append(full_name)
            url_value = str(rec.get("URL") or "").strip()
            if not url_value and doi:
                url_value = f"https://doi.org/{doi}"
            if not title or not url_value:
                continue
            combined = " ".join([title, abstract, journal, " ".join(authors)])
            if not self._is_article_like_item(title, url_value, doi, year):
                continue
            items.append(
                self._raw(
                    title=title,
                    url=url_value,
                    abstract=abstract,
                    full_text=combined,
                    doi=doi,
                    year=year,
                    journal=journal or "Crossref",
                    authors=tuple(authors),
                )
            )
            if len(items) >= limit:
                break
        return items


class SemanticScholarConnector(BaseConnector):
    """Semantic Scholar source connector."""

    profile = SourceProfile(
        source_key="semantic_scholar",
        search_url="https://api.semanticscholar.org/graph/v1/paper/search",
        mode="api",
        query_param="query",
        indexing_evidence="semantic scholar openalex crossref",
    )

    def _api_url(self, query: str, limit: int) -> str:
        """Api url."""

        return (
            "https://api.semanticscholar.org/graph/v1/paper/search"
            f"?query={quote_plus(query)}"
            f"&limit={max(1, min(limit * 3, 100))}"
            "&fields=title,url,abstract,authors,year,venue,externalIds,"
            "publicationTypes,openAccessPdf,journal"
            "&publicationTypes=Review,JournalArticle"
        )

    def _extract_from_payload(
        self, query: str, payload: dict, limit: int
    ) -> list[RawArticle]:
        """Extract from payload."""

        records = payload.get("data", [])
        items: list[RawArticle] = []
        for rec in records:
            if not isinstance(rec, dict):
                continue
            publication_types = {
                str(item).lower() for item in rec.get("publicationTypes", []) or []
            }
            if publication_types and not (
                {"journalarticle", "review"} & publication_types
            ):
                continue
            title = str(rec.get("title", "")).strip()
            abstract = str(rec.get("abstract", "")).strip()
            year_raw = rec.get("year")
            year = int(year_raw) if str(year_raw).isdigit() else None
            venue = str(rec.get("venue") or "").strip()
            journal_info = rec.get("journal", {})
            if isinstance(journal_info, dict) and not venue:
                venue = str(journal_info.get("name") or "").strip()
            authors = [
                str(author.get("name", "")).strip()
                for author in rec.get("authors", []) or []
                if isinstance(author, dict) and str(author.get("name", "")).strip()
            ]
            external_ids = rec.get("externalIds", {})
            doi = ""
            if isinstance(external_ids, dict):
                doi = str(external_ids.get("DOI") or "").strip()
            url_value = str(rec.get("url") or "").strip()
            if not url_value and doi:
                url_value = f"https://doi.org/{doi}"
            if not title or not url_value:
                continue
            combined = " ".join([title, abstract, venue, " ".join(authors)])
            if not self._is_article_like_item(title, url_value, doi, year):
                continue
            items.append(
                self._raw(
                    title=title,
                    url=url_value,
                    abstract=abstract,
                    full_text=combined,
                    doi=doi,
                    year=year,
                    journal=venue or "Semantic Scholar",
                    authors=tuple(authors),
                )
            )
            if len(items) >= limit:
                break
        return items


class PubMedConnector(BaseConnector):
    """PubMed source connector."""

    profile = SourceProfile(
        source_key="pubmed",
        search_url="https://eutils.ncbi.nlm.nih.gov/entrez/eutils/esearch.fcgi",
        mode="api",
        query_param="term",
        indexing_evidence="pubmed medline pmc",
    )

    def _extract_from_payload(
        self, query: str, payload: dict, limit: int
    ) -> list[RawArticle]:
        """Extract from a normalized PubMed payload."""

        records = payload.get("records", [])
        items: list[RawArticle] = []
        for rec in records:
            if not isinstance(rec, dict):
                continue
            title = str(rec.get("title", "")).strip()
            abstract = str(rec.get("abstract", "")).strip()
            journal = str(rec.get("journal", "PubMed")).strip() or "PubMed"
            year_raw = rec.get("year")
            year = int(year_raw) if str(year_raw).isdigit() else None
            doi = str(rec.get("doi", "")).strip()
            url_value = str(rec.get("url", "")).strip()
            if not url_value and title:
                pmid = str(rec.get("pmid", "")).strip()
                if pmid:
                    url_value = f"https://pubmed.ncbi.nlm.nih.gov/{pmid}/"
            authors = [
                str(author).strip()
                for author in rec.get("authors", []) or []
                if str(author).strip()
            ]
            publication_types = {
                str(item).strip().lower()
                for item in rec.get("publication_types", []) or []
                if str(item).strip()
            }
            if publication_types and not (
                {"journal article", "review"} & publication_types
            ):
                continue
            if not title or not url_value:
                continue
            combined = " ".join([title, abstract, journal, " ".join(authors)])
            if not self._is_article_like_item(title, url_value, doi, year):
                continue
            items.append(
                self._raw(
                    title=title,
                    url=url_value,
                    abstract=abstract,
                    full_text=combined,
                    doi=doi,
                    year=year,
                    journal=journal,
                    authors=tuple(authors),
                )
            )
            if len(items) >= limit:
                break
        return items

    def _fetch_api(self, query: str, limit: int) -> list[RawArticle]:
        """Fetch API."""

        search_url = (
            "https://eutils.ncbi.nlm.nih.gov/entrez/eutils/esearch.fcgi"
            f"?db=pubmed&retmode=json&sort=relevance&retmax={max(1, limit * 3)}"
            f"&term={quote_plus(query)}"
        )
        search_payload = self._request_json(search_url)
        idlist = (
            search_payload.get("esearchresult", {}).get("idlist", [])
            if isinstance(search_payload, dict)
            else []
        )
        ids = [str(item).strip() for item in idlist if str(item).strip()]
        if not ids:
            return []
        fetch_url = (
            "https://eutils.ncbi.nlm.nih.gov/entrez/eutils/efetch.fcgi"
            f"?db=pubmed&id={','.join(ids[: max(1, limit * 3)])}"
            "&retmode=xml"
        )
        xml_text = self._request_xml(fetch_url)
        root = ET.fromstring(xml_text)
        normalized: list[dict[str, object]] = []
        for pubmed_article in root.findall(".//PubmedArticle"):
            medline = pubmed_article.find("MedlineCitation")
            article_node = medline.find("Article") if medline is not None else None
            if article_node is None:
                continue
            title = "".join(article_node.findtext("ArticleTitle", default="")).strip()
            abstract_parts = [
                (node.text or "").strip()
                for node in article_node.findall("Abstract/AbstractText")
                if (node.text or "").strip()
            ]
            abstract = " ".join(abstract_parts)
            journal = article_node.findtext("Journal/Title", default="PubMed").strip()
            year = None
            journal_issue = article_node.find("Journal/JournalIssue")
            if journal_issue is not None:
                pub_date = journal_issue.find("PubDate")
                if pub_date is not None:
                    for tag in ("Year", "MedlineDate"):
                        value = pub_date.findtext(tag, default="").strip()
                        if value[:4].isdigit():
                            year = int(value[:4])
                            break
            authors = []
            for author in article_node.findall("AuthorList/Author"):
                family = (author.findtext("LastName", default="") or "").strip()
                given = (author.findtext("ForeName", default="") or "").strip()
                initials = (author.findtext("Initials", default="") or "").strip()
                full_name = " ".join(
                    part for part in [given or initials, family] if part
                ).strip()
                if full_name:
                    authors.append(full_name)
            publication_types = {
                (node.text or "").strip().lower()
                for node in article_node.findall("PublicationTypeList/PublicationType")
                if (node.text or "").strip()
            }
            doi = ""
            for article_id in pubmed_article.findall(".//ArticleId"):
                if str(article_id.attrib.get("IdType", "")).lower() == "doi":
                    doi = (article_id.text or "").strip()
                    break
            pmid = medline.findtext("PMID", default="").strip() if medline else ""
            url_value = f"https://pubmed.ncbi.nlm.nih.gov/{pmid}/" if pmid else ""
            normalized.append(
                {
                    "title": title,
                    "abstract": abstract,
                    "journal": journal,
                    "year": year,
                    "doi": doi,
                    "url": url_value,
                    "authors": authors,
                    "publication_types": list(publication_types),
                    "pmid": pmid,
                }
            )
        return self._extract_from_payload(query, {"records": normalized}, limit)


class UnpaywallConnector(BaseConnector):
    """Unpaywall source connector."""

    profile = SourceProfile(
        source_key="unpaywall",
        search_url="https://api.unpaywall.org/v2/search/",
        mode="api",
        query_param="query",
        indexing_evidence="crossref openalex unpaywall",
    )

    @staticmethod
    def _email() -> str:
        """Return the contact email required by Unpaywall."""

        configured = os.getenv("UNPAYWALL_EMAIL", "").strip()
        if configured:
            return configured
        return "cindex@app.local"

    def _api_url(self, query: str, limit: int) -> str:
        """Api url."""

        return (
            "https://api.unpaywall.org/v2/search/"
            f"?query={quote_plus(query)}"
            "&is_oa=true"
            f"&email={quote_plus(self._email())}"
        )

    def _doi_url(self, doi: str) -> str:
        """Build DOI lookup url."""

        return (
            "https://api.unpaywall.org/v2/"
            f"{quote_plus(doi)}?email={quote_plus(self._email())}"
        )

    def _direct_json(self, url: str) -> dict:
        """Fetch JSON from Unpaywall with a plain HTTP client."""

        last_error: Exception | None = None
        headers = {
            "Accept": "application/json",
            "User-Agent": "cindex/1.0",
        }
        for attempt in range(1, self.MAX_ATTEMPTS + 1):
            try:
                response = httpx.get(
                    url,
                    headers=headers,
                    timeout=self.REQUEST_TIMEOUT_SECONDS,
                    follow_redirects=True,
                )
                response.raise_for_status()
                payload = response.json()
                if not isinstance(payload, dict):
                    raise ConnectorFetchError(
                        f"{self.profile.source_key}: invalid JSON payload type"
                    )
                return payload
            except Exception as exc:  # pragma: no cover - network dependent
                last_error = exc
                if attempt < self.MAX_ATTEMPTS:
                    time.sleep(0.6 * attempt)
        raise ConnectorFetchError(
            f"{self.profile.source_key}: direct json request failed after retries:"
            f" {last_error}"
        )

    @staticmethod
    def _response_record(
        response: dict,
        *,
        snippet: str = "",
    ) -> tuple[str, str, str, str, int | None, str, str, str]:
        """Normalize a DOI response into article fields."""

        title = str(response.get("title", "")).strip()
        doi = str(response.get("doi", "")).strip()
        if doi.lower().startswith("https://doi.org/"):
            doi = doi.rsplit("/", 1)[-1]
        year_raw = response.get("year")
        year = int(year_raw) if str(year_raw).isdigit() else None
        journal = str(
            response.get("journal_name") or response.get("publisher") or ""
        ).strip()
        if not journal:
            journal = "Unpaywall"
        url_value = (
            str(response.get("url_for_landing_page") or "").strip()
            or str(response.get("doi_url") or "").strip()
            or str(response.get("url") or "").strip()
        )
        if not url_value and doi:
            url_value = f"https://doi.org/{doi}"
        genre = str(response.get("genre", "")).strip().lower()
        oa_status = str(response.get("oa_status", "")).strip()
        combined = " ".join([title, snippet, journal, oa_status, genre]).strip()
        return title, doi, url_value, journal, year, combined, oa_status, genre

    def _build_raw_from_response(
        self,
        response: dict,
        *,
        snippet: str = "",
        query: str,
    ) -> RawArticle | None:
        """Build a raw article from an Unpaywall DOI response."""

        if not isinstance(response, dict):
            return None
        if response.get("is_paratext"):
            return None
        title, doi, url_value, journal, year, combined, oa_status, genre = (
            self._response_record(response, snippet=snippet)
        )
        if genre and genre not in {
            "journal-article",
            "review-article",
            "article",
            "review",
            "research-article",
        }:
            return None
        if not title or not url_value or not doi:
            return None
        return replace(
            self._raw(
                title=title,
                url=url_value,
                abstract=snippet,
                full_text=combined,
                doi=doi,
                year=year,
                journal=journal,
            ),
            peer_review_evidence="peer reviewed",
            indexing_evidence="crossref openalex unpaywall",
            preprint_evidence="" if oa_status else "",
        )

    def _extract_from_payload(
        self, query: str, payload: dict, limit: int
    ) -> list[RawArticle]:
        """Extract from payload."""

        records = payload.get("results", [])
        items: list[RawArticle] = []
        for rec in records:
            if not isinstance(rec, dict):
                continue
            response = rec.get("response", {})
            if not isinstance(response, dict):
                continue
            snippet = str(rec.get("snippet", "")).strip()
            built = self._build_raw_from_response(
                response,
                snippet=snippet,
                query=query,
            )
            if built is None:
                continue
            items.append(built)
            if len(items) >= limit:
                break
        return items

    def _fetch_api(self, query: str, limit: int) -> list[RawArticle]:
        """Fetch API."""

        try:
            payload = self._direct_json(self._api_url(query, limit))
            items = self._extract_from_payload(query, payload, limit)
            if items:
                return items
        except ConnectorFetchError:
            pass

        candidate_rows = CrossrefConnector().fetch(query, limit=max(1, limit * 3))
        items: list[RawArticle] = []
        for candidate in candidate_rows:
            if not candidate.doi:
                continue
            try:
                payload = self._direct_json(self._doi_url(candidate.doi))
            except ConnectorFetchError:
                continue
            response = payload if isinstance(payload, dict) else {}
            built = self._build_raw_from_response(
                response,
                snippet=candidate.abstract,
                query=query,
            )
            if built is None:
                continue
            items.append(
                replace(
                    built,
                    abstract=built.abstract or candidate.abstract,
                    full_text=" ".join(
                        [
                            built.full_text,
                            candidate.full_text,
                        ]
                    ).strip(),
                )
            )
            if len(items) >= limit:
                break
        return items


class ExaConnector(BaseConnector):
    """Exa source connector."""

    profile = SourceProfile(
        source_key="exa",
        search_url="https://api.exa.ai/search",
        mode="api",
        indexing_evidence="exa research paper web search",
    )

    @staticmethod
    def _api_key() -> str:
        """Return the Exa API key."""

        return os.getenv("EXA_API_KEY", "").strip()

    def _request_json_payload(self, payload: dict) -> dict:
        """Send an Exa search request and return JSON."""

        api_key = self._api_key()
        if not api_key:
            raise ConnectorFetchError("exa: EXA_API_KEY is required")
        last_error: Exception | None = None
        headers = {
            "Accept": "application/json",
            "Content-Type": "application/json",
            "User-Agent": "cindex/1.0",
            "x-api-key": api_key,
        }
        for attempt in range(1, self.MAX_ATTEMPTS + 1):
            try:
                response = httpx.post(
                    self.profile.search_url,
                    headers=headers,
                    json=payload,
                    timeout=self.REQUEST_TIMEOUT_SECONDS,
                    follow_redirects=True,
                )
                response.raise_for_status()
                data = response.json()
                if not isinstance(data, dict):
                    raise ConnectorFetchError(
                        f"{self.profile.source_key}: invalid JSON payload type"
                    )
                return data
            except Exception as exc:  # pragma: no cover - network dependent
                last_error = exc
                if attempt < self.MAX_ATTEMPTS:
                    time.sleep(0.6 * attempt)
        raise ConnectorFetchError(
            f"{self.profile.source_key}: request failed after retries: {last_error}"
        )

    @staticmethod
    def _normalize_author_value(author: object) -> tuple[str, ...]:
        """Normalize author payload into a tuple."""

        if isinstance(author, str):
            cleaned = normalize_scholarly_text(author)
            return (cleaned,) if cleaned else ()
        if isinstance(author, dict):
            cleaned = normalize_scholarly_text(
                str(author.get("name") or author.get("full_name") or "").strip()
            )
            return (cleaned,) if cleaned else ()
        if isinstance(author, list):
            names: list[str] = []
            for item in author:
                names.extend(ExaConnector._normalize_author_value(item))
            return tuple(names)
        return ()

    def _extract_from_payload(
        self, query: str, payload: dict, limit: int
    ) -> list[RawArticle]:
        """Extract records from Exa search payload."""

        records = payload.get("results", [])
        if not isinstance(records, list):
            return []
        items: list[RawArticle] = []
        for rec in records:
            if not isinstance(rec, dict):
                continue
            title = str(rec.get("title") or rec.get("name") or "").strip()
            url_value = str(rec.get("url") or rec.get("id") or "").strip()
            text = str(
                rec.get("text") or rec.get("content") or rec.get("snippet") or ""
            ).strip()
            authors = self._normalize_author_value(rec.get("author"))
            if not authors and isinstance(rec.get("authors"), (list, dict, str)):
                authors = self._normalize_author_value(rec.get("authors"))
            published_date = str(
                rec.get("publishedDate")
                or rec.get("published_date")
                or rec.get("publishedAt")
                or ""
            ).strip()
            year = self._extract_year(published_date)
            doi = self._extract_doi(" ".join([title, text, url_value]))
            journal = urlparse(url_value).netloc or "Exa"
            combined = " ".join([title, text, journal, " ".join(authors)])
            if not title or not url_value:
                continue
            if not self._is_article_like_item(title, url_value, doi, year):
                continue
            items.append(
                self._raw(
                    title=title,
                    url=url_value,
                    abstract=text[:8000],
                    full_text=combined,
                    doi=doi,
                    year=year,
                    journal=journal,
                    authors=authors,
                )
            )
            if len(items) >= limit:
                break
        return items

    def _fetch_api(self, query: str, limit: int) -> list[RawArticle]:
        """Fetch records from the Exa search API."""

        payload = {
            "query": query,
            "type": "auto",
            "category": "research paper",
            "num_results": max(3, limit * 3),
            "contents": {"text": {"maxCharacters": 10000}},
            "systemPrompt": (
                "Prefer scholarly articles, review papers, and publisher "
                "landing pages. Avoid duplicates."
            ),
        }
        data = self._request_json_payload(payload)
        return self._extract_from_payload(query, data, limit)


class SciBotConnector(BaseConnector):
    """SciBot source connector."""

    profile = SourceProfile(
        source_key="scibot",
        search_url="wss://sci-bot.ru/",
        mode="ws",
        language="ru",
        indexing_evidence="licensed sci-bot corpus",
    )
    _browser_id_cache: str | None = None

    @staticmethod
    def _contact_cookie() -> str:
        """Return optional cookie string for SciBot."""

        return (
            os.getenv("SCIBOT_COOKIE", "").strip()
            or os.getenv("SCIBOT_COOKIES", "").strip()
        )

    def _ws_headers(self) -> dict[str, str]:
        """Build websocket handshake headers."""

        headers = self._generate_headers()
        headers.update(
            {
                "Accept": "*/*",
                "Accept-Language": "ru-RU,ru;q=0.9,en-US;q=0.8,en;q=0.7",
                "Cache-Control": "no-cache",
                "DNT": "1",
                "Origin": "https://sci-bot.ru",
                "Pragma": "no-cache",
                "Referer": "https://sci-bot.ru/",
                "Sec-GPC": "1",
            }
        )
        cookie = self._contact_cookie()
        if cookie:
            headers["Cookie"] = cookie
        headers.pop("Connection", None)
        headers.pop("Upgrade", None)
        headers.pop("Sec-WebSocket-Version", None)
        headers.pop("Sec-WebSocket-Key", None)
        headers.pop("Sec-WebSocket-Extensions", None)
        return headers

    @classmethod
    def _browser_id(cls) -> str:
        """Return a stable per-process browser identifier."""

        if cls._browser_id_cache:
            return cls._browser_id_cache
        candidate = os.getenv("SCIBOT_BROWSER_ID", "").strip()
        if not candidate:
            candidate = str(uuid.uuid4())
        cls._browser_id_cache = candidate
        return candidate

    @staticmethod
    def _payload_text(node: object) -> str:
        """Extract plain text from a websocket payload node."""

        if isinstance(node, str):
            return node
        if isinstance(node, dict):
            parts: list[str] = []
            for key in ("message", "content", "text", "answer", "response"):
                value = node.get(key)
                if isinstance(value, str):
                    parts.append(value)
            return " ".join(parts)
        return ""

    @staticmethod
    def _coerce_ws_message(message: object) -> object:
        """Coerce a websocket message into structured data when possible."""

        if isinstance(message, bytes):
            try:
                message = message.decode("utf-8")
            except Exception:
                return ""
        if isinstance(message, str):
            stripped = message.strip()
            if not stripped:
                return ""
            if stripped.startswith("{") or stripped.startswith("["):
                try:
                    return json.loads(stripped)
                except Exception:
                    return stripped
            return stripped
        return message

    @staticmethod
    def _looks_finished(message: object) -> bool:
        """Return whether a websocket message indicates completion."""

        if isinstance(message, str):
            return message.strip().lower() in {"done", "error"}
        if not isinstance(message, dict):
            return False
        return str(message.get("type", "")).lower() in {"done", "error"}

    @staticmethod
    def _normalize_authors(raw_authors: object) -> tuple[str, ...]:
        """Normalize author payload to a tuple of strings."""

        authors: list[str] = []
        if isinstance(raw_authors, str):
            for chunk in re.split(r"[;|,]", raw_authors):
                cleaned = normalize_scholarly_text(chunk)
                if cleaned:
                    authors.append(cleaned)
            return tuple(authors)
        if isinstance(raw_authors, list):
            for author in raw_authors:
                if isinstance(author, str):
                    cleaned = normalize_scholarly_text(author)
                elif isinstance(author, dict):
                    cleaned = normalize_scholarly_text(
                        str(
                            author.get("name")
                            or author.get("full_name")
                            or author.get("author")
                            or ""
                        )
                    )
                else:
                    cleaned = ""
                if cleaned:
                    authors.append(cleaned)
        return tuple(authors)

    @staticmethod
    def _solve_altcha_challenge(challenge: dict) -> str:
        """Solve the ALTCHA proof-of-work challenge."""

        salt = str(challenge.get("salt", ""))
        target = str(challenge.get("challenge", "")).lower()
        maxnumber = int(challenge.get("maxnumber") or 0)
        signature = challenge.get("signature")
        algorithm = challenge.get("algorithm")
        for number in range(maxnumber + 1):
            digest = hashlib.sha256(f"{salt}{number}".encode()).hexdigest()
            if digest == target:
                payload = {
                    "algorithm": algorithm,
                    "challenge": challenge.get("challenge"),
                    "number": number,
                    "salt": challenge.get("salt"),
                    "signature": signature,
                }
                encoded = json.dumps(payload, separators=(",", ":"), ensure_ascii=False)
                return base64.b64encode(encoded.encode("utf-8")).decode("ascii")
        raise ConnectorFetchError("scibot: failed to solve altcha challenge")

    def _build_from_article_payload(
        self,
        payload: dict,
        query: str,
    ) -> RawArticle | None:
        """Build a raw article from a structured websocket payload."""

        title = normalize_scholarly_text(
            str(
                payload.get("title")
                or payload.get("name")
                or payload.get("article_title")
                or ""
            )
        )
        abstract = normalize_scholarly_text(
            str(
                payload.get("abstract")
                or payload.get("summary")
                or payload.get("snippet")
                or payload.get("description")
                or ""
            ),
            max_length=12000,
        )
        journal = normalize_scholarly_text(
            str(
                payload.get("journal")
                or payload.get("source")
                or payload.get("venue")
                or payload.get("publisher")
                or "SciBot"
            ),
            max_length=300,
        )
        year = self._extract_year(
            " ".join(
                [
                    title,
                    abstract,
                    journal,
                    str(payload.get("year") or payload.get("published") or ""),
                ]
            )
        )
        doi = self._extract_doi(
            " ".join(
                [
                    title,
                    abstract,
                    journal,
                    str(payload.get("doi") or payload.get("url") or ""),
                ]
            )
        )
        url = str(payload.get("url") or payload.get("link") or "").strip()
        if not url and doi:
            url = f"https://doi.org/{doi}"
        if not title or not url:
            return None
        authors = self._normalize_authors(payload.get("authors"))
        full_text = normalize_scholarly_text(
            " ".join(
                [
                    title,
                    abstract,
                    journal,
                    " ".join(authors),
                    doi,
                    url,
                    str(payload.get("full_text") or payload.get("text") or ""),
                ]
            )
        )
        return self._raw(
            title=title,
            url=url,
            abstract=abstract,
            full_text=full_text,
            doi=doi,
            year=year,
            journal=journal,
            authors=authors,
        )

    def _iter_article_payloads(self, node: object) -> list[dict]:
        """Collect article-like payloads from websocket data."""

        items: list[dict] = []
        if isinstance(node, dict):
            candidate_keys = {
                "title",
                "doi",
                "authors",
                "url",
                "link",
                "abstract",
                "summary",
                "journal",
                "venue",
            }
            if candidate_keys.intersection(node.keys()):
                items.append(node)
            for key in (
                "articles",
                "results",
                "items",
                "data",
                "payload",
                "response",
                "message",
                "content",
                "article",
            ):
                value = node.get(key)
                if isinstance(value, (dict, list)):
                    items.extend(self._iter_article_payloads(value))
        elif isinstance(node, list):
            for item in node:
                items.extend(self._iter_article_payloads(item))
        return items

    def _extract_from_ws_messages(
        self, query: str, messages: list[object], limit: int
    ) -> list[RawArticle]:
        """Extract records from collected websocket messages."""

        seen_keys: set[tuple[str, str, str]] = set()
        items: list[RawArticle] = []
        for response in messages:
            for article_payload in self._iter_article_payloads(response):
                built = self._build_from_article_payload(article_payload, query)
                if built is None:
                    continue
                dedupe_key = (
                    built.doi.lower().strip(),
                    built.title.lower().strip(),
                    built.url.lower().strip(),
                )
                if dedupe_key in seen_keys:
                    continue
                seen_keys.add(dedupe_key)
                items.append(built)
                if len(items) >= limit:
                    return items

        return items

    def _run_scibot_queue(self, query: str, lang: str) -> tuple[str, str, str]:
        """Wait through the SciBot queue phase until the job is released."""

        queue_secret: str | None = None
        queue_token: str | None = None
        enqueued_at: str | None = None
        headers = self._ws_headers()

        while True:
            with connect(
                f"{self.profile.search_url}?queue=1",
                origin="https://sci-bot.ru",
                additional_headers=headers,
                user_agent_header=headers.get("User-Agent"),
                open_timeout=None,
                ping_interval=20,
                ping_timeout=20,
                close_timeout=5,
            ) as websocket:
                join_payload: dict[str, object]
                if queue_secret:
                    join_payload = {"type": "queue_resume", "secret": queue_secret}
                else:
                    join_payload = {
                        "type": "queue_join",
                        "question": query,
                        "lang": lang,
                        "sb": self._browser_id(),
                    }
                websocket.send(
                    json.dumps(join_payload, separators=(",", ":"), ensure_ascii=False)
                )

                while True:
                    try:
                        message = websocket.recv()
                    except ConnectionClosed:
                        break
                    if message is None:
                        break
                    payload_message = self._coerce_ws_message(message)
                    if (
                        isinstance(payload_message, dict)
                        and payload_message.get("type") == "queue_verify"
                        and isinstance(payload_message.get("challenge"), dict)
                    ):
                        websocket.send(
                            json.dumps(
                                {
                                    "type": "queue_verify_response",
                                    "payload": self._solve_altcha_challenge(
                                        payload_message["challenge"]
                                    ),
                                },
                                separators=(",", ":"),
                                ensure_ascii=False,
                            )
                        )
                        continue
                    if (
                        isinstance(payload_message, dict)
                        and payload_message.get("type") == "queue_position"
                    ):
                        queue_secret = str(
                            payload_message.get("secret") or queue_secret or ""
                        )
                        continue
                    if (
                        isinstance(payload_message, dict)
                        and payload_message.get("type") == "queue_ready"
                    ):
                        queue_token = str(payload_message.get("queueToken") or "")
                        enqueued_at = str(payload_message.get("enqueuedAt") or "")
                        if queue_token and enqueued_at:
                            return (
                                queue_token,
                                enqueued_at,
                                str(payload_message.get("question") or query),
                            )
                        return "", "", str(payload_message.get("question") or query)
                    if isinstance(payload_message, dict) and payload_message.get(
                        "type"
                    ) in {"queue_cancelled", "queue_expired"}:
                        raise ConnectorFetchError(
                            f"{self.profile.source_key}: queue "
                            f"{payload_message.get('type')}"
                        )
            if not queue_secret:
                continue

    def _run_scibot_answer_ws(
        self,
        query: str,
        limit: int,
        queue_token: str = "",
        enqueued_at: str = "",
    ) -> list[object]:
        """Collect the full SciBot answer stream from the websocket protocol."""

        headers = self._ws_headers()
        responses: list[object] = []
        pending_queue_token = queue_token
        pending_enqueued_at = enqueued_at
        while True:
            with connect(
                self.profile.search_url,
                origin="https://sci-bot.ru",
                additional_headers=headers,
                user_agent_header=headers.get("User-Agent"),
                open_timeout=None,
                ping_interval=20,
                ping_timeout=20,
                close_timeout=5,
            ) as websocket:
                payload: dict[str, object] = {
                    "type": "chat",
                    "message": query,
                    "lang": "ru",
                }
                if pending_queue_token:
                    payload["queueToken"] = pending_queue_token
                    if pending_enqueued_at:
                        payload["enqueuedAt"] = pending_enqueued_at
                    pending_queue_token = ""
                    pending_enqueued_at = ""
                websocket.send(json.dumps(payload, ensure_ascii=False))
                while True:
                    try:
                        message = websocket.recv()
                    except ConnectionClosed:
                        break
                    if message is None:
                        break
                    payload_message = self._coerce_ws_message(message)
                    if (
                        isinstance(payload_message, dict)
                        and payload_message.get("type") == "verify"
                        and isinstance(payload_message.get("challenge"), dict)
                    ):
                        websocket.send(
                            json.dumps(
                                {
                                    "type": "verify_response",
                                    "payload": self._solve_altcha_challenge(
                                        payload_message["challenge"]
                                    ),
                                },
                                separators=(",", ":"),
                                ensure_ascii=False,
                            )
                        )
                    elif (
                        isinstance(payload_message, dict)
                        and payload_message.get("type") == "queue_redirect"
                    ):
                        queue_token, enqueued_at, query = self._run_scibot_queue(
                            query, "ru"
                        )
                        pending_queue_token = queue_token
                        pending_enqueued_at = enqueued_at
                        break
                    responses.append(payload_message)
                    if self._looks_finished(payload_message):
                        return responses
                if pending_queue_token:
                    continue
                break
        return responses

    def _fetch_ws(self, query: str, limit: int) -> list[RawArticle]:
        """Fetch records from the SciBot websocket endpoint."""

        try:
            responses = self._run_scibot_answer_ws(query, limit)
        except Exception as exc:  # pragma: no cover - network dependent
            raise ConnectorFetchError(
                f"{self.profile.source_key}: websocket request failed: {exc}"
            ) from exc

        return self._extract_from_ws_messages(query, responses, limit)


class ArXivConnector(BaseConnector):
    """arXiv source connector."""

    profile = SourceProfile(
        source_key="arxiv",
        search_url="https://export.arxiv.org/api/query",
        mode="api",
        query_param="search_query",
        indexing_evidence="openalex crossref semantic scholar",
    )

    def _api_url(self, query: str, limit: int) -> str:
        """Api url."""

        arxiv_query = quote_plus(f"all:{query}")
        return (
            "https://export.arxiv.org/api/query"
            f"?search_query={arxiv_query}"
            "&sortBy=relevance&sortOrder=descending"
            f"&start=0&max_results={max(1, limit * 3)}"
        )

    @staticmethod
    def _ns() -> dict[str, str]:
        """Return XML namespaces."""

        return {
            "atom": "http://www.w3.org/2005/Atom",
            "arxiv": "http://arxiv.org/schemas/atom",
        }

    def _extract_from_payload(
        self, query: str, payload: dict, limit: int
    ) -> list[RawArticle]:
        """Extract from a normalized arXiv payload."""

        records = payload.get("records", [])
        items: list[RawArticle] = []
        for rec in records:
            if not isinstance(rec, dict):
                continue
            title = str(rec.get("title", "")).strip()
            abstract = str(rec.get("abstract", "")).strip()
            journal = str(rec.get("journal", "arXiv")).strip() or "arXiv"
            year_raw = rec.get("year")
            year = int(year_raw) if str(year_raw).isdigit() else None
            doi = str(rec.get("doi", "")).strip()
            url_value = str(rec.get("url", "")).strip()
            authors = [
                str(author).strip()
                for author in rec.get("authors", []) or []
                if str(author).strip()
            ]
            if not (doi or str(rec.get("journal_ref", "")).strip()):
                continue
            if not title or not url_value:
                continue
            combined = " ".join([title, abstract, journal, " ".join(authors)])
            items.append(
                self._raw(
                    title=title,
                    url=url_value,
                    abstract=abstract,
                    full_text=combined,
                    doi=doi,
                    year=year,
                    journal=journal,
                    authors=tuple(authors),
                )
            )
            if len(items) >= limit:
                break
        return items

    def _fetch_api(self, query: str, limit: int) -> list[RawArticle]:
        """Fetch API."""

        xml_text = self._request_xml(self._api_url(query, limit))
        root = ET.fromstring(xml_text)
        ns = self._ns()
        normalized: list[dict[str, object]] = []
        for entry in root.findall("atom:entry", ns):
            title = (
                entry.findtext("atom:title", default="", namespaces=ns) or ""
            ).strip()
            abstract = (
                entry.findtext("atom:summary", default="", namespaces=ns) or ""
            ).strip()
            url_value = (
                entry.findtext("atom:id", default="", namespaces=ns) or ""
            ).strip()
            published = (
                entry.findtext("atom:published", default="", namespaces=ns) or ""
            ).strip()
            year = self._extract_year(published)
            authors = [
                (author.findtext("atom:name", default="", namespaces=ns) or "").strip()
                for author in entry.findall("atom:author", ns)
                if (
                    author.findtext("atom:name", default="", namespaces=ns) or ""
                ).strip()
            ]
            doi = (entry.findtext("arxiv:doi", default="", namespaces=ns) or "").strip()
            journal_ref = (
                entry.findtext("arxiv:journal_ref", default="", namespaces=ns) or ""
            ).strip()
            normalized.append(
                {
                    "title": title,
                    "abstract": abstract,
                    "journal": journal_ref or "arXiv",
                    "year": year,
                    "doi": doi,
                    "url": url_value,
                    "authors": authors,
                    "journal_ref": journal_ref,
                }
            )
        return self._extract_from_payload(query, {"records": normalized}, limit)


class DOAJConnector(BaseConnector):
    """DOAJ source connector."""

    profile = SourceProfile(
        source_key="doaj",
        search_url="https://doaj.org/api/search/articles",
        mode="api",
        query_param="q",
        indexing_evidence="doaj scopus",
    )

    def _api_url(self, query: str, limit: int) -> str:
        """Api url."""
        return (
            f"https://doaj.org/api/search/articles/{quote_plus(query)}?pageSize={limit}"
        )

    def _extract_from_payload(
        self, query: str, payload: dict, limit: int
    ) -> list[RawArticle]:
        """Extract from payload."""
        results = payload.get("results", [])
        items: list[RawArticle] = []
        for rec in results[:limit]:
            bib = rec.get("bibjson", {})
            title = bib.get("title", "")
            abstract = bib.get("abstract", "")
            journal = bib.get("journal", {}).get("title", "DOAJ")
            year = bib.get("year")
            doi = ""
            for identifier in bib.get("identifier", []):
                if str(identifier.get("type", "")).lower() == "doi":
                    doi = identifier.get("id", "")
                    break
            link = bib.get("link", [{}])
            url_value = link[0].get("url", "") if link else ""
            if not title or not url_value:
                continue
            items.append(
                self._raw(
                    title=title,
                    url=url_value,
                    abstract=abstract,
                    full_text=" ".join([title, abstract]),
                    doi=doi,
                    year=int(year) if str(year).isdigit() else None,
                    journal=journal,
                )
            )
        return items


class JSTAGEConnector(BaseConnector):
    """JSTAGE source connector."""

    profile = SourceProfile(
        source_key="jstage",
        search_url="https://www.jstage.jst.go.jp/search/global",
        query_param="globalSearchKey",
        result_selector=".search-result-item, .global-search-result-item, article, li",
        title_selector=".title a, h3 a, h2 a, a[href]",
        abstract_selector=".snippet, .abstract, p",
        journal_selector=".journal, .journal-title, .source",
        indexing_evidence="scopus web of science",
    )

    def fetch(self, query: str, limit: int = 5) -> list[RawArticle]:
        """Fetch records from the upstream source."""
        try:
            return self._fetch_api(query, limit)
        except ConnectorFetchError:
            return self._fetch_html(query, limit)

    def _fetch_api(self, query: str, limit: int) -> list[RawArticle]:
        """Fetch API."""
        tokens = self._query_tokens(query)
        attempts: list[str] = [query.strip()]
        if tokens:
            attempts.extend(
                [
                    " ".join(tokens[:3]).strip(),
                    " ".join(tokens[:2]).strip(),
                    tokens[0].strip(),
                ]
            )
        seen: set[str] = set()
        for api_query in attempts:
            if not api_query or api_query in seen:
                continue
            seen.add(api_query)
            url = (
                "https://api.jstage.jst.go.jp/searchapi/do"
                f"?service=3&keyword={quote_plus(api_query)}&count={max(3, limit * 2)}"
            )
            xml_payload = self._request_xml_text(url)
            soup = BeautifulSoup(xml_payload, "xml")
            entries = soup.find_all("entry")
            if not entries:
                continue
            items: list[RawArticle] = []
            for entry in entries:
                title_node = entry.find("article_title") or entry.find("title")
                link_node = entry.find("article_link") or entry.find("id")
                summary_node = entry.find("summary")
                journal_node = entry.find("material_title") or entry.find(
                    "journal_title"
                )
                doi_node = entry.find("doi")
                pubyear_node = entry.find("pubyear")
                updated_node = entry.find("updated")
                author_node = entry.find("author")

                title = title_node.get_text(" ", strip=True) if title_node else ""
                url_value = link_node.get_text(" ", strip=True) if link_node else ""
                abstract = (
                    summary_node.get_text(" ", strip=True) if summary_node else ""
                )
                journal = (
                    journal_node.get_text(" ", strip=True)
                    if journal_node
                    else "J-STAGE"
                )
                doi = doi_node.get_text(" ", strip=True) if doi_node else ""
                year_hint = " ".join(
                    [
                        pubyear_node.get_text(" ", strip=True) if pubyear_node else "",
                        updated_node.get_text(" ", strip=True) if updated_node else "",
                        title,
                    ]
                )
                year = self._extract_year(year_hint)
                combined = " ".join(
                    [
                        title,
                        abstract,
                        journal,
                        author_node.get_text(" ", strip=True) if author_node else "",
                    ]
                )
                if not title or not url_value.startswith("http"):
                    continue
                if not self._is_article_like_item(title, url_value, doi, year):
                    continue
                items.append(
                    self._raw(
                        title=title,
                        url=url_value,
                        abstract=abstract,
                        full_text=combined,
                        doi=doi or self._extract_doi(combined),
                        year=year,
                        journal=journal,
                    )
                )
                if len(items) >= limit:
                    return items
            if items:
                return items
        raise ConnectorFetchError("jstage: api returned no parseable entries")

    def _request_xml_text(self, url: str) -> str:
        """Send a request for XML text."""
        scraper = self._build_scraper()
        headers = self._generate_headers()
        headers.setdefault("Accept", "application/xml,text/xml,*/*")
        response = scraper.get(
            url, headers=headers, timeout=self.REQUEST_TIMEOUT_SECONDS
        )
        status = int(response.status_code)
        if status >= 400:
            raise ConnectorFetchError(f"{self.profile.source_key}: http {status}")
        return response.content.decode("utf-8", errors="replace")

    def _fetch_html(self, query: str, limit: int) -> list[RawArticle]:
        """Fetch HTML."""
        attempts = [
            (
                self.profile.search_url,
                {self.profile.query_param: query},
            ),
            (
                "https://www.jstage.jst.go.jp/search/global/_search/-char/en",
                {"globalSearchKey": query},
            ),
        ]
        for url, params in attempts:
            try:
                html = self._request_text(url, params=params)
                soup = BeautifulSoup(html, "lxml")
                self._assert_page_is_parseable(html, soup)
                items = self._extract_from_html(query, soup, limit)
                if items:
                    return items
            except ConnectorFetchError:
                continue
        raise ConnectorFetchError("jstage: unable to obtain parseable result page")

    def _extract_from_html(
        self, query: str, soup: BeautifulSoup, limit: int
    ) -> list[RawArticle]:
        """Extract from HTML."""
        rows = soup.select(
            ".search-result-item, .item-list li, .global-search-result-item, "
            ".result-list li, .source-row, article"
        )
        candidates: list[RawArticle] = []
        for row in rows:
            title_node = row.select_one(".title a, h3 a, h2 a, .art_title a, a[href]")
            if not title_node:
                continue
            title = title_node.get_text(" ", strip=True)
            href = urljoin(self.profile.search_url, title_node.get("href", ""))
            abstract_node = row.select_one(".snippet, .item-summary, .abstract, p")
            journal_node = row.select_one(
                ".journal, .journal-title, .item-title, .source"
            )
            abstract = abstract_node.get_text(" ", strip=True) if abstract_node else ""
            journal = (
                journal_node.get_text(" ", strip=True)
                if journal_node
                else self.profile.source_key.upper()
            )
            combined = " ".join(
                [title, abstract, journal, row.get_text(" ", strip=True)]
            )
            doi = self._extract_doi(combined)
            year = self._extract_year(combined)
            if not self._is_article_like_item(title, href, doi, year):
                continue
            candidates.append(
                self._raw(
                    title=title,
                    url=href,
                    abstract=abstract,
                    full_text=combined,
                    doi=doi,
                    year=year,
                    journal=journal,
                )
            )
            if len(candidates) >= limit * 3:
                break
        if candidates:
            return candidates[:limit]
        json_ld_items = self._extract_json_ld_articles(soup, limit)
        if json_ld_items:
            return json_ld_items
        return []


class CiNiiConnector(BaseConnector):
    """Ci Nii source connector."""

    profile = SourceProfile(
        source_key="cinii",
        search_url="https://cir.nii.ac.jp/opensearch/v2/all",
        mode="api",
        query_param="q",
        result_selector=".search-result__item, .item, article, li",
        title_selector="h3 a, .title a, a[href]",
        abstract_selector=".snippet, .description, p",
        journal_selector=".publisher, .journal, .source",
        indexing_evidence="scopus web of science",
    )

    def fetch(self, query: str, limit: int = 5) -> list[RawArticle]:
        """Fetch records from the upstream source."""
        try:
            return self._fetch_api(query, limit)
        except ConnectorFetchError:
            return super()._fetch_html(query, limit)

    def _api_url(self, query: str, limit: int) -> str:
        """Api url."""
        return (
            "https://cir.nii.ac.jp/opensearch/v2/all"
            f"?format=json&q={quote_plus(query)}&lang=en&count={limit}"
        )

    def _extract_from_payload(
        self, query: str, payload: dict, limit: int
    ) -> list[RawArticle]:
        """Extract from payload."""
        entries = payload.get("items", [])
        items: list[RawArticle] = []
        for entry in entries[:limit]:
            if not isinstance(entry, dict):
                continue
            title = str(entry.get("title", "")).strip()
            link_info = entry.get("link", {})
            url_value = ""
            if isinstance(link_info, dict):
                url_value = str(link_info.get("@id") or link_info.get("id") or "")
            elif isinstance(link_info, str):
                url_value = link_info
            if not title or not url_value:
                continue
            journal = str(
                entry.get("prism:publicationName")
                or entry.get("dc:publisher")
                or entry.get("dc:source")
                or "CiNii"
            )
            abstract = str(entry.get("description") or "")
            combined = " ".join(
                [title, abstract, journal, json.dumps(entry, ensure_ascii=False)]
            )
            items.append(
                self._raw(
                    title=title,
                    url=url_value,
                    abstract=abstract,
                    full_text=combined,
                    doi=self._extract_doi(combined),
                    year=self._extract_year(
                        " ".join([str(entry.get("dc:date", "")), combined])
                    ),
                    journal=journal,
                )
            )
        return items


class COAJConnector(BaseConnector):
    """COAJ source connector."""

    profile = SourceProfile(
        source_key="coaj",
        search_url="https://www.coaj.cn/search",
        query_param="query",
        result_selector=".search-item, article, li",
        title_selector="h2 a, h3 a, .title a, a[href]",
        abstract_selector=".abstract, .summary, p",
        journal_selector=".journal, .source, .meta",
        indexing_evidence="scopus web of science",
    )

    def fetch(self, query: str, limit: int = 5) -> list[RawArticle]:
        """Fetch records from the upstream source."""
        try:
            items = self._fetch_from_public_api(query, limit)
            if items:
                return items
        except ConnectorFetchError:
            items = []
        attempts = [
            (self.profile.search_url, {"query": query}),
            ("https://www.coaj.cn/", {"query": query}),
        ]
        for url, params in attempts:
            try:
                html = self._request_text(url, params=params)
                soup = BeautifulSoup(html, "lxml")
                self._assert_page_is_parseable(html, soup)
                items = self._extract_from_html(query, soup, limit)
                if items:
                    return items
            except ConnectorFetchError:
                continue
        return []

    def _fetch_from_public_api(self, query: str, limit: int) -> list[RawArticle]:
        # COAJ exposes public free journal catalogs without auth.
        """Fetch from public API."""
        payloads: list[dict] = []
        for url in (
            "https://www.coaj.cn/api/v1/pub-journal/all",
            "https://www.coaj.cn/api/v1/journal-top/show",
        ):
            try:
                payloads.append(self._request_json(url))
            except ConnectorFetchError:
                continue
        if not payloads:
            raise ConnectorFetchError("coaj: public api unavailable")

        rows: list[dict] = []
        for payload in payloads:
            data = payload.get("data")
            if isinstance(data, list):
                rows.extend([x for x in data if isinstance(x, dict)])

        items: list[RawArticle] = []
        seen_urls: set[str] = set()
        for rec in rows:
            title_en = str(rec.get("titleEn") or "").strip()
            title_zh = str(rec.get("titleZh") or "").strip()
            title = title_en or title_zh
            if not title:
                continue
            homepage = str(rec.get("homepage") or "").strip()
            base_id = str(rec.get("baseId") or rec.get("journalId") or "").strip()
            url_value = homepage if homepage.startswith("http") else ""
            if not url_value and base_id:
                url_value = f"https://www.coaj.cn/journal/{base_id}"
            if not url_value.startswith("http"):
                continue
            if url_value in seen_urls:
                continue
            seen_urls.add(url_value)
            issn = str(rec.get("issn") or "").strip()
            combined = " ".join(
                [title_en, title_zh, issn, str(rec.get("chargePublishFee") or "")]
            ).strip()
            items.append(
                self._raw(
                    title=title,
                    url=url_value,
                    abstract=(
                        f"COAJ journal record. ISSN: {issn}"
                        if issn
                        else "COAJ journal record"
                    ),
                    full_text=combined,
                    doi=self._extract_doi(combined),
                    year=self._extract_year(combined),
                    journal=title,
                )
            )
            if len(items) >= limit:
                break
        return items


class SciEngineConnector(BaseConnector):
    """Sci Engine source connector."""

    profile = SourceProfile(
        source_key="sciengine",
        search_url="https://www.sciengine.com/search/search",
        query_param="searchText",
        result_selector=".search-item, article, li",
        title_selector=".title a, h2 a, h3 a, a[href]",
        abstract_selector=".abstract, .summary, p",
        journal_selector=".journal, .meta, .source",
        indexing_evidence="scopus web of science",
    )

    def fetch(self, query: str, limit: int = 5) -> list[RawArticle]:
        """Fetch records from the upstream source."""
        try:
            html = self._request_text(
                self.profile.search_url,
                params={"searchType": "all", "searchText": query},
            )
            soup = BeautifulSoup(html, "lxml")
            items = self._extract_from_html(query, soup, limit)
            if items:
                return items
        except ConnectorFetchError:
            return []
        return []


class SciOpenConnector(BaseConnector):
    """Sci Open source connector."""

    profile = SourceProfile(
        source_key="sciopen",
        search_url="https://www.sciopen.com/search",
        result_selector=".search-result-item, article, li",
        title_selector="h2 a, h3 a, .title a, a[href]",
        abstract_selector=".abstract, .summary, p",
        journal_selector=".journal, .source, .meta",
        indexing_evidence="scopus web of science",
    )

    def fetch(self, query: str, limit: int = 5) -> list[RawArticle]:
        """Fetch records from the upstream source."""
        try:
            items = self._fetch_api(query, limit)
            if items:
                return items
        except ConnectorFetchError:
            return self._fetch_home_fallback(query, limit)
        return self._fetch_home_fallback(query, limit)

    def _fetch_api(self, query: str, limit: int) -> list[RawArticle]:
        # Warm-up route creates valid search session context on SciOpen.
        """Fetch API."""
        _ = self._request_text(
            "https://www.sciopen.com/search/to_search_page",
            params={"keywords": query},
        )
        scraper = self._build_scraper()
        headers = self._generate_headers()
        headers["Content-Type"] = "application/json;charset=UTF-8"
        headers.setdefault("Accept", "application/json,text/plain,*/*")
        payload = {
            "keyword": "",
            "startTime": "",
            "endTime": "",
            "keywordDTO": [{"type": "title", "key": query, "key2": "", "tag": 1}],
            "pageNo": 1,
            "pageSize": max(3, limit * 2),
            "orderBy": 0,
            "journalId": "",
        }
        response = scraper.post(
            "https://www.sciopen.com/search/search",
            json=payload,
            headers=headers,
            timeout=self.REQUEST_TIMEOUT_SECONDS,
        )
        if int(response.status_code) >= 400:
            raise ConnectorFetchError(f"sciopen: api http {response.status_code}")
        try:
            data = response.json()
        except ValueError as exc:
            raise ConnectorFetchError("sciopen: invalid api json") from exc

        records = (
            ((data.get("object") or {}).get("page") or {}).get("items")
            if isinstance(data, dict)
            else []
        )
        if not isinstance(records, list):
            return []
        items: list[RawArticle] = []
        for rec in records[: limit * 3]:
            if not isinstance(rec, dict):
                continue
            title_raw = str(rec.get("title") or "").strip()
            title = re.sub(r"<[^>]+>", "", title_raw).strip()
            doi = str(rec.get("doi") or "").strip()
            if not title or not doi:
                continue
            url_value = f"https://www.sciopen.com/article/{doi}"
            abstract = str(rec.get("abstracted") or "").strip()
            journal = str(rec.get("journalName") or "SciOpen").strip()
            year_hint = " ".join(
                [
                    str(rec.get("pubTimeStr") or ""),
                    str(rec.get("firstVersionStrPubTime") or ""),
                ]
            )
            year = self._extract_year(year_hint)
            combined = " ".join(
                [
                    title,
                    abstract,
                    journal,
                    str(rec.get("author") or ""),
                    str(rec.get("keyword") or ""),
                ]
            )
            if not self._is_article_like_item(title, url_value, doi, year):
                continue
            items.append(
                self._raw(
                    title=title,
                    url=url_value,
                    abstract=abstract,
                    full_text=combined,
                    doi=doi,
                    year=year,
                    journal=journal,
                )
            )
            if len(items) >= limit:
                break
        return items

    def _fetch_home_fallback(self, query: str, limit: int) -> list[RawArticle]:
        """Fetch home fallback."""
        html = self._request_text("https://www.sciopen.com/home")
        soup = BeautifulSoup(html, "lxml")
        items: list[RawArticle] = []
        for link in soup.select("a[href*='/article/']"):
            title = (link.get_text(" ", strip=True) or "").strip()
            href = urljoin(self.profile.search_url, link.get("href", ""))
            if not title or not href.startswith("http"):
                continue
            combined = title
            doi = self._extract_doi(href) or self._extract_doi(title)
            year = self._extract_year(title)
            if not self._is_article_like_item(title, href, doi, year):
                continue
            items.append(
                self._raw(
                    title=title,
                    url=href,
                    abstract="",
                    full_text=combined,
                    doi=doi,
                    year=year,
                    journal="SciOpen",
                )
            )
            if len(items) >= limit:
                break
        return items


class CyberLeninkaConnector(BaseConnector):
    """Cyber Leninka source connector."""

    profile = SourceProfile(
        source_key="cyberleninka",
        search_url="https://cyberleninka.ru/search",
        query_param="q",
        result_selector=".article-item, article, li",
        title_selector=".title a, h2 a, h3 a, a[href]",
        abstract_selector=".annotation, .abstract, p",
        journal_selector=".journal, .source, .publication",
        language="ru",
        indexing_evidence="rinc scopus web of science",
    )

    def fetch(self, query: str, limit: int = 5) -> list[RawArticle]:
        """Fetch records from the upstream source."""
        try:
            return self._fetch_api(query, limit)
        except ConnectorFetchError:
            return super()._fetch_html(query, limit)

    def _fetch_api(self, query: str, limit: int) -> list[RawArticle]:
        """Fetch API."""
        scraper = self._build_scraper()
        headers = self._generate_headers()
        headers["Content-Type"] = "application/json"
        payload = {
            "q": query,
            "size": max(3, limit * 2),
            "from": 0,
            "mode": "articles",
        }
        response = scraper.post(
            "https://cyberleninka.ru/api/search",
            json=payload,
            headers=headers,
            timeout=self.REQUEST_TIMEOUT_SECONDS,
        )
        if int(response.status_code) >= 400:
            raise ConnectorFetchError(f"cyberleninka: api http {response.status_code}")
        try:
            data = response.json()
        except ValueError as exc:  # pragma: no cover - network dependent
            raise ConnectorFetchError("cyberleninka: invalid api json") from exc
        return self._extract_from_payload(query, data, limit)

    def _extract_from_payload(
        self, query: str, payload: dict, limit: int
    ) -> list[RawArticle]:
        """Extract from payload."""
        records = payload.get("articles", [])
        items: list[RawArticle] = []
        for rec in records[: limit * 3]:
            if not isinstance(rec, dict):
                continue
            title = re.sub(r"<[^>]+>", "", str(rec.get("name") or "")).strip()
            abstract = re.sub(r"<[^>]+>", "", str(rec.get("annotation") or "")).strip()
            href = str(rec.get("link") or "").strip()
            url_value = urljoin(self.profile.search_url, href)
            year = self._extract_year(str(rec.get("year") or ""))
            journal = str(rec.get("journal") or "CyberLeninka")
            doi = self._extract_doi(" ".join([title, abstract, journal]))
            combined = " ".join(
                [
                    title,
                    abstract,
                    journal,
                    " ".join(
                        str(x) for x in rec.get("authors", []) if isinstance(x, str)
                    ),
                ]
            )
            if not title or not url_value.startswith("http"):
                continue
            if not self._is_article_like_item(title, url_value, doi, year):
                continue
            items.append(
                self._raw(
                    title=title,
                    url=url_value,
                    abstract=abstract,
                    full_text=combined,
                    doi=doi,
                    year=year,
                    journal=journal,
                )
            )
            if len(items) >= limit:
                break
        return items

    def _extract_from_html(
        self, query: str, soup: BeautifulSoup, limit: int
    ) -> list[RawArticle]:
        """Extract from HTML."""
        rows = soup.select(
            ".article-item, .articles-list .item, .content-list__item, article, li"
        )
        items: list[RawArticle] = []
        for row in rows:
            title_node = row.select_one(".title a, h2 a, h3 a, a[href]")
            if not title_node:
                continue
            title = title_node.get_text(" ", strip=True)
            href = urljoin(self.profile.search_url, title_node.get("href", ""))
            abstract_node = row.select_one(".annotation, .description, .abstract, p")
            journal_node = row.select_one(".journal, .publication, .source, .subtitle")
            abstract = abstract_node.get_text(" ", strip=True) if abstract_node else ""
            journal = (
                journal_node.get_text(" ", strip=True)
                if journal_node
                else self.profile.source_key.upper()
            )
            combined = " ".join(
                [title, abstract, journal, row.get_text(" ", strip=True)]
            )
            doi = self._extract_doi(combined)
            year = self._extract_year(combined)
            if not self._is_article_like_item(title, href, doi, year):
                continue
            items.append(
                self._raw(
                    title=title,
                    url=href,
                    abstract=abstract,
                    full_text=combined,
                    doi=doi,
                    year=year,
                    journal=journal,
                )
            )
            if len(items) >= limit:
                break
        if items:
            return items
        json_ld_items = self._extract_json_ld_articles(soup, limit)
        if json_ld_items:
            return json_ld_items
        return super()._extract_from_html(query, soup, limit)


class MathNetConnector(BaseConnector):
    """Math Net source connector."""

    profile = SourceProfile(
        source_key="mathnet",
        search_url="https://www.mathnet.ru/php/search.phtml",
        query_param="query",
        result_selector="article, .source-row, .paper, .result, li",
        title_selector=".title a, h3 a, a[href]",
        abstract_selector=".abstract, .summary, p",
        journal_selector=".journal, .source",
        indexing_evidence="web of science scopus zbmath",
    )

    def fetch(self, query: str, limit: int = 5) -> list[RawArticle]:
        """Fetch records from the upstream source."""
        attempts = [query.strip(), query.strip()]
        tokens = self._query_tokens(query)
        if tokens:
            attempts.append(tokens[0])
        attempts.extend(["probability", "probability"])
        for attempt_query in attempts:
            if not attempt_query:
                continue
            try:
                items = self._search_mathnet(attempt_query, query, limit)
            except ConnectorFetchError:
                continue
            if items:
                return items
        return self._fetch_home_fallback(limit)

    def _search_mathnet(
        self,
        search_query: str,
        original_query: str,
        limit: int,
    ) -> list[RawArticle]:
        """Search mathnet."""
        scraper = self._build_scraper()
        headers = self._generate_headers()
        headers["Content-Type"] = "application/x-www-form-urlencoded"
        payload = {
            "tjrnid": "",
            "keywords": search_query,
            "where_keyw": "any",
            "authors": "",
            "organisation": "",
            "fundername": "",
            "grantnumber": "",
            "v1": "",
            "v2": "",
            "yr1": "",
            "yr2": "",
        }
        last_error: Exception | None = None
        html = ""
        for attempt in range(1, self.MAX_ATTEMPTS + 1):
            try:
                response = scraper.post(
                    "https://www.mathnet.ru/php/searchpapers_do.phtml?jrnid=&option_lang=eng",
                    data=payload,
                    headers=headers,
                    timeout=self.REQUEST_TIMEOUT_SECONDS,
                )
                if int(response.status_code) >= 400:
                    raise ConnectorFetchError(f"mathnet: http {response.status_code}")
                html = response.text
                break
            except Exception as exc:
                last_error = exc
                if attempt < self.MAX_ATTEMPTS:
                    time.sleep(0.6 * attempt)
        if not html:
            raise ConnectorFetchError(
                f"mathnet: request failed after retries: {last_error}"
            )
        soup = BeautifulSoup(html, "lxml")
        candidates: list[RawArticle] = []
        relevant: list[RawArticle] = []
        for link in soup.select("a[href*='/eng/']"):
            title = (link.get_text(" ", strip=True) or "").strip()
            href = urljoin("https://www.mathnet.ru", link.get("href", ""))
            context = (
                link.find_parent("tr").get_text(" ", strip=True)
                if link.find_parent("tr")
                else link.get_text(" ", strip=True)
            )
            combined = " ".join([title, context])
            doi = self._extract_doi(combined)
            year = self._extract_year(combined)
            if len(title) < 14 or not href.startswith("http"):
                continue
            built = self._raw(
                title=title,
                url=href,
                abstract=context[:700],
                full_text=combined,
                doi=doi,
                year=year,
                journal="MathNet.Ru",
            )
            candidates.append(built)
            relevant.append(built)
            if len(candidates) >= limit * 5:
                break
        if relevant:
            return relevant[:limit]
        if candidates:
            return candidates[:limit]
        return []

    @staticmethod
    def _split_authors(author_blob: str) -> tuple[str, ...]:
        """Split authors."""
        cleaned = re.sub(r"\s+", " ", author_blob or "").strip().strip(",")
        if not cleaned:
            return ()
        parts = [
            part.strip(" ,;")
            for part in re.split(r"\s+and\s+|,", cleaned)
            if part.strip(" ,;")
        ]
        return tuple(dict.fromkeys(parts))

    def enrich_raw(self, raw: RawArticle) -> RawArticle:
        """Enrich the raw source payload with parsed metadata."""
        enriched = super().enrich_raw(raw)
        if not raw.url.startswith("http"):
            return enriched
        try:
            html = self._request_text(raw.url)
        except ConnectorFetchError:
            return enriched
        soup = self._sanitize_html_soup(BeautifulSoup(html, "lxml"))
        page_text = self._html_text(soup)
        if self._looks_like_challenge_page(page_text):
            return enriched
        normalized = re.sub(r"\s+", " ", page_text.replace("\xa0", " ")).strip()
        citation_match = re.search(
            r"(?P<authors>.+?),\s*[“\"](?P<title>.+?)[”\"]\s*,\s*(?P<journal>.+?),\s*(?P<volume>\d+)\s*:\s*(?P<issue>\d+)\s*\((?P<year>\d{4})\),\s*(?P<pages>[\d–-]+)",
            normalized,
        )
        abstract_match = re.search(
            (
                r"Abstract:\s*(?P<abstract>.*?)\s*"
                r"(?:Keywords:|Full-text PDF|First page|References:|$)"
            ),
            normalized,
            flags=re.IGNORECASE,
        )
        if not citation_match and not abstract_match:
            return enriched

        authors_blob = citation_match.group("authors").strip() if citation_match else ""
        title = (
            citation_match.group("title").strip() if citation_match else enriched.title
        )
        journal = (
            citation_match.group("journal").strip()
            if citation_match
            else enriched.journal
        )
        volume = (
            citation_match.group("volume").strip()
            if citation_match
            else enriched.volume
        )
        issue = (
            citation_match.group("issue").strip() if citation_match else enriched.issue
        )
        pages = (
            citation_match.group("pages").strip() if citation_match else enriched.pages
        )
        year = int(citation_match.group("year")) if citation_match else enriched.year
        abstract = (
            abstract_match.group("abstract").strip()
            if abstract_match
            else enriched.abstract
        )
        doi = enriched.doi or self._extract_doi(normalized)
        authors = self._split_authors(authors_blob)
        full_text = " ".join(
            part
            for part in [
                title,
                authors_blob,
                journal,
                f"{volume}:{issue}" if volume or issue else "",
                pages,
                abstract,
                normalized,
            ]
            if part
        )
        return replace(
            enriched,
            title=title[:900],
            abstract=abstract[:8000],
            full_text=full_text[:20000],
            doi=doi,
            year=year,
            journal=journal[:300],
            authors=authors,
            volume=volume[:32],
            issue=issue[:32],
            pages=pages[:32],
        )

    def _fetch_home_fallback(self, limit: int) -> list[RawArticle]:
        """Fetch home fallback."""
        try:
            html = self._request_text(
                "https://www.mathnet.ru/php/search.phtml?wshow=search&option_lang=eng"
            )
        except ConnectorFetchError:
            return []
        soup = BeautifulSoup(html, "lxml")
        items: list[RawArticle] = []
        for link in soup.select("a[href*='/eng/']"):
            title = (link.get_text(" ", strip=True) or "").strip()
            href = urljoin("https://www.mathnet.ru", link.get("href", ""))
            if len(title) < 14 or not href.startswith("http"):
                continue
            combined = " ".join([title, link.find_parent().get_text(" ", strip=True)])
            items.append(
                self._raw(
                    title=title,
                    url=href,
                    abstract=combined[:700],
                    full_text=combined,
                    doi=self._extract_doi(combined),
                    year=self._extract_year(combined),
                    journal="MathNet.Ru",
                )
            )
            if len(items) >= limit:
                break
        return items


class PMCConnector(BaseConnector):
    """PMC source connector."""

    profile = SourceProfile(
        source_key="pmc",
        search_url="https://pmc.ncbi.nlm.nih.gov/",
        result_selector=".rslt, .search-results-item, article, li",
        title_selector=".title a, h2 a, a[href]",
        abstract_selector=".snippet, .abstract, p",
        journal_selector=".jrnl, .journal, .source",
        indexing_evidence="pmc medline",
    )


class COREConnector(BaseConnector):
    """CORE source connector."""

    profile = SourceProfile(
        source_key="core",
        search_url="https://api.core.ac.uk/v3/search/works",
        result_selector=".result-item, article, li",
        title_selector="h2 a, h3 a, .title a, a[href]",
        abstract_selector=".description, .abstract, p",
        journal_selector=".publisher, .source, .journal",
        indexing_evidence="core doaj",
    )

    def fetch(self, query: str, limit: int = 5) -> list[RawArticle]:
        """Fetch records from the upstream source."""
        try:
            return self._fetch_api(query, limit)
        except ConnectorFetchError:
            return super()._fetch_html(query, limit)

    def _api_url(self, query: str, limit: int) -> str:
        """Api url."""
        return (
            "https://api.core.ac.uk/v3/search/works"
            f"?q={quote_plus(query)}&page=1&pageSize={max(3, limit)}"
        )

    def _extract_from_payload(
        self, query: str, payload: dict, limit: int
    ) -> list[RawArticle]:
        """Extract from payload."""
        records = payload.get("results", [])
        items: list[RawArticle] = []
        for rec in records[: limit * 2]:
            if not isinstance(rec, dict):
                continue
            source_urls = rec.get("sourceFulltextUrls")
            first_source_url = (
                source_urls[0]
                if isinstance(source_urls, list) and source_urls
                else None
            )
            journals = rec.get("journals")
            first_journal = (
                journals[0] if isinstance(journals, list) and journals else {}
            )
            title = str(rec.get("title") or "").strip()
            url_value = str(
                rec.get("downloadUrl") or first_source_url or rec.get("id") or ""
            ).strip()
            if url_value.isdigit():
                url_value = f"https://core.ac.uk/works/{url_value}"
            abstract = str(rec.get("abstract") or "")
            journal = str(rec.get("publisher") or first_journal.get("title") or "CORE")
            combined = " ".join(
                [title, abstract, journal, json.dumps(rec, ensure_ascii=False)]
            )
            doi = str(rec.get("doi") or "") or self._extract_doi(combined)
            year_hint = " ".join(
                [
                    str(rec.get("yearPublished") or ""),
                    str(rec.get("publishedDate") or ""),
                    combined,
                ]
            )
            year = self._extract_year(year_hint)
            if not title or not url_value.startswith("http"):
                continue
            items.append(
                self._raw(
                    title=title,
                    url=url_value
                    if url_value.startswith("http")
                    else f"https://core.ac.uk/works/{rec.get('id')}",
                    abstract=abstract,
                    full_text=combined,
                    doi=doi,
                    year=year,
                    journal=journal,
                )
            )
            if len(items) >= limit:
                break
        return items

    def _extract_from_html(
        self, query: str, soup: BeautifulSoup, limit: int
    ) -> list[RawArticle]:
        # CORE search is often rendered via Next.js; prefer app-state payload first.
        """Extract from HTML."""
        next_data = soup.select_one("script#__NEXT_DATA__")
        if next_data and next_data.string:
            try:
                payload = json.loads(next_data.string)
            except json.JSONDecodeError:
                payload = {}
            records = (
                payload.get("props", {})
                .get("pageProps", {})
                .get("searchResults", {})
                .get("data", [])
            )
            items: list[RawArticle] = []
            if isinstance(records, list):
                for rec in records[:limit]:
                    if not isinstance(rec, dict):
                        continue
                    title = str(rec.get("title") or "").strip()
                    url_value = str(
                        rec.get("downloadUrl") or rec.get("url") or ""
                    ).strip()
                    abstract = str(rec.get("abstract") or "")
                    journal = str(rec.get("publisher") or rec.get("journal") or "CORE")
                    combined = " ".join([title, abstract, journal, str(rec)])
                    if not title or not url_value:
                        continue
                    items.append(
                        self._raw(
                            title=title,
                            url=url_value,
                            abstract=abstract,
                            full_text=combined,
                            doi=self._extract_doi(combined),
                            year=self._extract_year(combined),
                            journal=journal,
                        )
                    )
                if items:
                    return items
        json_ld_items = self._extract_json_ld_articles(soup, limit)
        if json_ld_items:
            return json_ld_items
        return super()._extract_from_html(query, soup, limit)


class SciELOConnector(BaseConnector):
    """Sci ELO source connector."""

    profile = SourceProfile(
        source_key="scielo",
        search_url="https://www.scielo.org/en/search/",
        result_selector=".item, article, li",
        title_selector="h3 a, h2 a, .title a, a[href]",
        abstract_selector=".abstract, .snippet, p",
        journal_selector=".publication, .journal, .source",
        indexing_evidence="scopus web of science",
    )

    OA_MIRRORS = (
        "https://scielo.isciii.es/oai/scielo-oai.php",
        "https://www.scielo.org.mx/oai/scielo-oai.php",
    )

    def fetch(self, query: str, limit: int = 5) -> list[RawArticle]:
        """Fetch records from the upstream source."""
        try:
            return self._fetch_oai(query, limit)
        except ConnectorFetchError:
            return self._fetch_html(query, limit)

    def _fetch_oai(self, query: str, limit: int) -> list[RawArticle]:
        """Fetch OAI."""
        current_year = datetime.now(UTC).year
        from_date = f"{max(2000, current_year - 8)}-01-01"
        for endpoint in self.OA_MIRRORS:
            url = f"{endpoint}?verb=ListRecords&metadataPrefix=oai_dc&from={from_date}"
            items: list[RawArticle] = []
            token: str | None = None
            for _ in range(3):
                response_xml = self._request_xml_text(url)
                soup = BeautifulSoup(response_xml, "xml")
                records = soup.find_all("record")
                for rec in records:
                    if rec.find("header", attrs={"status": "deleted"}):
                        continue
                    titles = [
                        x.get_text(" ", strip=True) for x in rec.find_all("dc:title")
                    ]
                    if not titles:
                        continue
                    title = titles[0].strip()
                    ids = [
                        x.get_text(" ", strip=True)
                        for x in rec.find_all("dc:identifier")
                    ]
                    url_value = next((x for x in ids if x.startswith("http")), "")
                    descriptions = [
                        x.get_text(" ", strip=True)
                        for x in rec.find_all("dc:description")
                    ]
                    abstract = descriptions[0].strip() if descriptions else ""
                    sources = [
                        x.get_text(" ", strip=True) for x in rec.find_all("dc:source")
                    ]
                    journal = sources[0].strip() if sources else "SciELO"
                    dates = [
                        x.get_text(" ", strip=True) for x in rec.find_all("dc:date")
                    ]
                    subjects = [
                        x.get_text(" ", strip=True) for x in rec.find_all("dc:subject")
                    ]
                    combined = " ".join(
                        [
                            title,
                            abstract,
                            journal,
                            " ".join(subjects),
                            " ".join(ids),
                        ]
                    )
                    doi = self._extract_doi(combined)
                    year = self._extract_year(" ".join(dates + [title]))
                    if not url_value:
                        continue
                    if not self._is_article_like_item(title, url_value, doi, year):
                        continue
                    items.append(
                        self._raw(
                            title=title,
                            url=url_value,
                            abstract=abstract,
                            full_text=combined,
                            doi=doi,
                            year=year,
                            journal=journal,
                        )
                    )
                    if len(items) >= limit:
                        return items
                token_node = soup.find("resumptionToken")
                token = token_node.get_text(strip=True) if token_node else ""
                if not token:
                    break
                url = f"{endpoint}?verb=ListRecords&resumptionToken={quote_plus(token)}"
            if items:
                return items[:limit]
        raise ConnectorFetchError(
            "scielo: oai mirrors yielded no query-relevant entries"
        )

    def _request_xml_text(self, url: str) -> str:
        """Send a request for XML text."""
        scraper = self._build_scraper()
        headers = self._generate_headers()
        headers.setdefault("Accept", "application/xml,text/xml,*/*")
        response = scraper.get(
            url, headers=headers, timeout=self.REQUEST_TIMEOUT_SECONDS
        )
        status = int(response.status_code)
        if status >= 400:
            raise ConnectorFetchError(f"{self.profile.source_key}: http {status}")
        return response.content.decode("utf-8", errors="replace")

    def _fetch_html(self, query: str, limit: int) -> list[RawArticle]:
        """Fetch HTML."""
        attempts = [
            (
                self.profile.search_url,
                {
                    self.profile.query_param: query,
                },
            ),
            (
                "https://search.scielo.org/",
                {
                    self.profile.query_param: query,
                    "lang": "en",
                    "count": "20",
                    "from": "0",
                    "output": "site",
                    "format": "summary",
                    "page": "1",
                },
            ),
        ]
        for url, params in attempts:
            try:
                html = self._request_text(url, params=params)
                soup = BeautifulSoup(html, "lxml")
                self._assert_page_is_parseable(html, soup)
                items = self._extract_from_html(query, soup, limit)
                if items:
                    return items
            except ConnectorFetchError:
                continue
        raise ConnectorFetchError("scielo: unable to obtain parseable result page")

    def _extract_from_html(
        self, query: str, soup: BeautifulSoup, limit: int
    ) -> list[RawArticle]:
        """Extract from HTML."""
        rows = soup.select(".item, .search-results .item, .result, article, li")
        candidates: list[RawArticle] = []
        for row in rows:
            title_node = row.select_one(".title a, h2 a, h3 a, a[href]")
            if not title_node:
                continue
            title = title_node.get_text(" ", strip=True)
            href = urljoin(self.profile.search_url, title_node.get("href", ""))
            abstract_node = row.select_one(".abstract, .snippet, .description, p")
            journal_node = row.select_one(".journal, .publication, .source, .meta")
            abstract = abstract_node.get_text(" ", strip=True) if abstract_node else ""
            journal = (
                journal_node.get_text(" ", strip=True)
                if journal_node
                else self.profile.source_key.upper()
            )
            combined = " ".join(
                [title, abstract, journal, row.get_text(" ", strip=True)]
            )
            doi = self._extract_doi(combined)
            year = self._extract_year(combined)
            if not self._is_article_like_item(title, href, doi, year):
                continue
            candidates.append(
                self._raw(
                    title=title,
                    url=href,
                    abstract=abstract,
                    full_text=combined,
                    doi=doi,
                    year=year,
                    journal=journal,
                )
            )
            if len(candidates) >= limit * 3:
                break
        if candidates:
            return candidates[:limit]
        json_ld_items = self._extract_json_ld_articles(soup, limit)
        if json_ld_items:
            return json_ld_items
        return []


class RedalycConnector(BaseConnector):
    """Redalyc source connector."""

    profile = SourceProfile(
        source_key="redalyc",
        search_url="https://www.redalyc.org/service/r2020/getArticles",
        mode="api",
        query_param="q",
        result_selector=".item, article, li",
        title_selector="h3 a, .title a, a[href]",
        abstract_selector=".summary, .abstract, p",
        journal_selector=".journal, .source",
        indexing_evidence="scopus redalyc",
    )

    def fetch(self, query: str, limit: int = 5) -> list[RawArticle]:
        """Fetch records from the upstream source."""
        tokens = self._query_tokens(query)
        attempts = [
            query.strip(),
            " ".join(tokens[:3]).strip() if tokens else "",
            " ".join(tokens[:2]).strip() if tokens else "",
        ]
        for q in attempts:
            if not q:
                continue
            encoded = quote_plus(q)
            url = (
                "https://www.redalyc.org/service/r2020/getArticles/"
                f"{encoded}/1/{max(10, limit * 3)}/0/default"
            )
            try:
                payload = self._request_json(url)
            except ConnectorFetchError:
                continue
            items = self._extract_from_payload(query, payload, limit)
            if items:
                return items
        return []

    def _extract_from_payload(
        self, query: str, payload: dict, limit: int
    ) -> list[RawArticle]:
        """Extract from payload."""
        records = payload.get("resultados", [])
        items: list[RawArticle] = []
        for rec in records[: limit * 4]:
            if not isinstance(rec, dict):
                continue
            title = str(rec.get("titulo") or "").strip()
            abstract = str(rec.get("resumen") or "")
            abstract = re.sub(r"^[a-z]{2}\s*:\s*", "", abstract, flags=re.IGNORECASE)
            article_id = str(rec.get("cveArticulo") or "").strip()
            url_value = (
                f"https://www.redalyc.org/articulo.oa?id={article_id}"
                if article_id
                else ""
            )
            journal = str(rec.get("nomRevista") or "Redalyc")
            doi = str(rec.get("doiTitulo") or "").strip() or self._extract_doi(
                " ".join([title, abstract])
            )
            year = self._extract_year(str(rec.get("anioArticulo") or ""))
            combined = " ".join(
                [title, abstract, journal, json.dumps(rec, ensure_ascii=False)]
            )
            if not title or not url_value:
                continue
            if not self._is_article_like_item(title, url_value, doi, year):
                continue
            items.append(
                self._raw(
                    title=title,
                    url=url_value,
                    abstract=abstract,
                    full_text=combined,
                    doi=doi,
                    year=year,
                    journal=journal,
                )
            )
            if len(items) >= limit:
                break
        return items


class KoreaScienceConnector(BaseConnector):
    """Korea Science source connector."""

    profile = SourceProfile(
        source_key="koreascience",
        search_url="https://koreascience.kr/search.page",
        query_param="keywords",
        result_selector=".list-item, article, li",
        title_selector="h3 a, h2 a, .title a, a[href]",
        abstract_selector=".abstract, .summary, p",
        journal_selector=".journal, .source",
        indexing_evidence="kci scopus",
    )

    def fetch(self, query: str, limit: int = 5) -> list[RawArticle]:
        """Fetch records from the upstream source."""
        attempts = [
            ("https://koreascience.kr/search.page", {"keywords": query}),
            ("https://www.koreascience.kr/search.page", {"keywords": query}),
            ("https://koreascience.kr/index.jsp", {}),
        ]
        for url, params in attempts:
            try:
                html = self._request_text(url, params=params)
                soup = BeautifulSoup(html, "lxml")
                self._assert_page_is_parseable(html, soup)
                items = self._extract_from_html(query, soup, limit)
                if items:
                    return items
            except ConnectorFetchError:
                continue
        return []


class PerseeConnector(BaseConnector):
    """Persee source connector."""

    profile = SourceProfile(
        source_key="persee",
        search_url="https://www.persee.fr/search",
        result_selector=".result-item, article, li",
        title_selector="h2 a, h3 a, .title a, a[href]",
        abstract_selector=".resume, .abstract, p",
        journal_selector=".revue, .journal, .source",
        indexing_evidence="scopus web of science",
    )

    def fetch(self, query: str, limit: int = 5) -> list[RawArticle]:
        """Fetch records from the upstream source."""
        try:
            items = self._fetch_oai(query, limit)
            if items:
                return items
        except ConnectorFetchError:
            pass
        return self._fetch_html(query, limit)

    def _fetch_oai(self, query: str, limit: int) -> list[RawArticle]:
        """Fetch OAI."""
        base = "http://oai.persee.fr/oai"
        url = f"{base}?verb=ListRecords&metadataPrefix=oai_dc&set=persee:serie"
        items: list[RawArticle] = []
        for _ in range(3):
            xml_text = self._request_text(url)
            parsed, token = self._parse_oai_records(xml_text, query, limit - len(items))
            items.extend(parsed)
            if len(items) >= limit or not token:
                break
            url = (
                f"{base}?verb=ListRecords&metadataPrefix=oai_dc&resumptionToken="
                f"{quote_plus(token)}"
            )
        return items[:limit]

    def _parse_oai_records(
        self, xml_text: str, query: str, remaining: int
    ) -> tuple[list[RawArticle], str]:
        """Parse OAI records."""
        try:
            root = ET.fromstring(xml_text)
        except ET.ParseError:
            return ([], "")
        ns = {
            "oai": "http://www.openarchives.org/OAI/2.0/",
            "dc": "http://purl.org/dc/elements/1.1/",
        }
        candidates: list[RawArticle] = []
        relevant: list[RawArticle] = []
        for rec in root.findall(".//oai:record", ns):
            header = rec.find("oai:header", ns)
            if header is not None and header.get("status") == "deleted":
                continue
            metadata = rec.find("oai:metadata", ns)
            if metadata is None:
                continue
            title = metadata.findtext(".//dc:title", default="", namespaces=ns).strip()
            description = metadata.findtext(
                ".//dc:description", default="", namespaces=ns
            ).strip()
            identifiers = [
                x.text.strip()
                for x in metadata.findall(".//dc:identifier", ns)
                if x.text
            ]
            sources = [
                x.text.strip() for x in metadata.findall(".//dc:source", ns) if x.text
            ]
            journal = sources[0] if sources else "Persee"
            combined = " ".join([title, description, " ".join(identifiers), journal])
            doi = self._extract_doi(combined)
            year = self._extract_year(combined)
            url_value = next((x for x in identifiers if x.startswith("http")), "")
            if not title or not url_value:
                continue
            if not self._is_article_like_item(title, url_value, doi, year):
                continue
            built = self._raw(
                title=title,
                url=url_value,
                abstract=description,
                full_text=combined,
                doi=doi,
                year=year,
                journal=journal,
            )
            candidates.append(built)
            relevant.append(built)
        token_node = root.find(".//oai:resumptionToken", ns)
        token = (
            token_node.text.strip()
            if token_node is not None and token_node.text
            else ""
        )
        if relevant:
            return (relevant[:remaining], token)
        return (candidates[:remaining], token)


class OpenEditionConnector(BaseConnector):
    """Open Edition source connector."""

    profile = SourceProfile(
        source_key="openedition",
        search_url="https://oai.openedition.org/",
        result_selector=".search-result, article, li",
        title_selector="h2 a, .title a, a[href]",
        abstract_selector=".description, .abstract, p",
        journal_selector=".journal, .source",
        indexing_evidence="scopus web of science",
    )

    def fetch(self, query: str, limit: int = 5) -> list[RawArticle]:
        """Fetch records from the upstream source."""
        url = "https://oai.openedition.org/?verb=ListRecords&metadataPrefix=oai_dc"
        items: list[RawArticle] = []
        for _ in range(3):
            try:
                xml_text = self._request_text(url)
            except ConnectorFetchError:
                break
            parsed, token = self._parse_oai_records(xml_text, query, limit - len(items))
            items.extend(parsed)
            if len(items) >= limit or not token:
                break
            url = f"https://oai.openedition.org/?verb=ListRecords&resumptionToken={quote_plus(token)}"
        return items[:limit]

    def _parse_oai_records(
        self, xml_text: str, query: str, remaining: int
    ) -> tuple[list[RawArticle], str]:
        """Parse OAI records."""
        try:
            root = ET.fromstring(xml_text)
        except ET.ParseError:
            return ([], "")
        ns = {
            "oai": "http://www.openarchives.org/OAI/2.0/",
            "dc": "http://purl.org/dc/elements/1.1/",
        }
        candidates: list[RawArticle] = []
        relevant: list[RawArticle] = []
        for rec in root.findall(".//oai:record", ns):
            metadata = rec.find("oai:metadata", ns)
            if metadata is None:
                continue
            title = metadata.findtext(".//dc:title", default="", namespaces=ns).strip()
            description = metadata.findtext(
                ".//dc:description", default="", namespaces=ns
            ).strip()
            identifiers = [
                x.text.strip()
                for x in metadata.findall(".//dc:identifier", ns)
                if x.text
            ]
            url_value = next((x for x in identifiers if x.startswith("http")), "")
            sources = [
                x.text.strip() for x in metadata.findall(".//dc:source", ns) if x.text
            ]
            journal = sources[0] if sources else "OpenEdition"
            combined = " ".join([title, description, " ".join(identifiers), journal])
            doi = self._extract_doi(combined)
            year = self._extract_year(combined)
            if not title or not url_value:
                continue
            if not self._is_true_article_record(
                url_value, doi, journal, title, description
            ):
                continue
            if not self._is_article_like_item(title, url_value, doi, year):
                continue
            built = self._raw(
                title=title,
                url=url_value,
                abstract=description,
                full_text=combined,
                doi=doi,
                year=year,
                journal=journal,
            )
            candidates.append(built)
            relevant.append(built)
            if len(candidates) >= remaining * 3:
                break
        items = relevant[:remaining] if relevant else candidates[:remaining]
        token_node = root.find(".//oai:resumptionToken", ns)
        token = (
            token_node.text.strip()
            if token_node is not None and token_node.text
            else ""
        )
        return (items, token)

    @staticmethod
    def _is_true_article_record(
        url: str,
        doi: str,
        journal: str,
        title: str,
        description: str,
    ) -> bool:
        """Return whether true article record."""
        lowered_url = (url or "").lower()
        lowered_doi = (doi or "").lower()
        lowered_journal = (journal or "").lower()
        lowered_title = (title or "").lower()
        lowered_description = (description or "").lower()

        if lowered_doi.startswith("10.58079/"):
            return False
        if "hypotheses.org" in lowered_url or "hypotheses.org" in lowered_journal:
            return False
        if "blog" in lowered_title or "blog" in lowered_description:
            return False
        parsed = urlparse(url)
        if parsed.scheme not in {"http", "https"}:
            return False
        if (
            "journals.openedition.org" in lowered_url
            or "books.openedition.org" in lowered_url
            or "doi.org/10.4000/" in lowered_url
            or lowered_doi.startswith("10.4000/")
        ):
            return True
        return False


class RevistasCSICConnector(BaseConnector):
    """Revistas CSIC source connector."""

    profile = SourceProfile(
        source_key="revistas_csic",
        search_url="https://revistas.csic.es/index.php/index/search",
        result_selector=".obj_article_summary, article, li",
        title_selector=".title a, h3 a, a[href]",
        abstract_selector=".summary, .abstract, p",
        journal_selector=".subtitle, .journal, .source",
        indexing_evidence="scopus web of science",
    )

    OAI_URL = "https://redc.revistas.csic.es/index.php/redc/oai"
    OPENALEX_PUBLISHER_ID = "P4362726015"

    def fetch(self, query: str, limit: int = 5) -> list[RawArticle]:
        """Fetch records from the upstream source."""
        try:
            items = self._fetch_openalex(query, limit)
            if items:
                return items
        except ConnectorFetchError:
            items = []

        url = f"{self.OAI_URL}?verb=ListRecords&metadataPrefix=oai_dc"
        items: list[RawArticle] = []
        for _ in range(3):
            xml_text = self._request_xml(url)
            if not xml_text:
                break
            parsed, token = self._parse_oai_records(xml_text, query, limit - len(items))
            items.extend(parsed)
            if len(items) >= limit or not token:
                break
            url = f"{self.OAI_URL}?verb=ListRecords&resumptionToken={quote_plus(token)}"
        if items:
            return items[:limit]
        try:
            return self._fetch_html(query, limit)
        except ConnectorFetchError:
            return []

    def _fetch_openalex(self, query: str, limit: int) -> list[RawArticle]:
        """Fetch openalex."""
        url = (
            "https://api.openalex.org/works"
            f"?filter=primary_location.source.host_organization:{self.OPENALEX_PUBLISHER_ID}"
            f"&search={quote_plus(query)}&per-page={max(3, limit * 2)}"
        )
        try:
            response = httpx.get(url, timeout=self.REQUEST_TIMEOUT_SECONDS)
            response.raise_for_status()
            payload = response.json()
        except Exception as exc:
            raise ConnectorFetchError(
                f"revistas_csic: openalex request failed: {exc}"
            ) from exc
        records = payload.get("results", [])
        if not isinstance(records, list):
            return []
        items: list[RawArticle] = []
        for rec in records[: limit * 3]:
            if not isinstance(rec, dict):
                continue
            title = str(rec.get("display_name") or rec.get("title") or "").strip()
            doi_url = str(rec.get("doi") or "").strip()
            doi = doi_url.replace("https://doi.org/", "").replace("http://doi.org/", "")
            primary_location = rec.get("primary_location") or {}
            if not isinstance(primary_location, dict):
                primary_location = {}
            source = primary_location.get("source") or {}
            if not isinstance(source, dict):
                source = {}
            url_value = str(
                primary_location.get("landing_page_url")
                or primary_location.get("pdf_url")
                or doi_url
                or ""
            ).strip()
            journal = str(source.get("display_name") or "Revistas CSIC").strip()
            abstract = ""
            abstract_index = rec.get("abstract_inverted_index")
            if isinstance(abstract_index, dict):
                abstract = MedknowConnector._build_abstract_from_index(abstract_index)
            year_raw = rec.get("publication_year")
            year = int(year_raw) if str(year_raw).isdigit() else None
            combined = " ".join(
                [title, abstract, journal, str(rec.get("language") or "")]
            )
            if not title or not url_value.startswith("http"):
                continue
            if not self._is_article_like_item(title, url_value, doi, year):
                continue
            items.append(
                self._raw(
                    title=title,
                    url=url_value,
                    abstract=abstract,
                    full_text=combined,
                    doi=doi,
                    year=year,
                    journal=journal,
                )
            )
            if len(items) >= limit:
                break
        return items

    def _request_xml(self, url: str) -> str:
        """Send a request for XML."""
        try:
            return self._request_text(url)
        except Exception:
            return ""

    def _parse_oai_records(
        self, xml_text: str, query: str, remaining: int
    ) -> tuple[list[RawArticle], str]:
        """Parse OAI records."""
        try:
            root = ET.fromstring(xml_text)
        except ET.ParseError:
            return ([], "")
        ns = {
            "oai": "http://www.openarchives.org/OAI/2.0/",
            "dc": "http://purl.org/dc/elements/1.1/",
        }
        items: list[RawArticle] = []
        for rec in root.findall(".//oai:record", ns):
            metadata = rec.find("oai:metadata", ns)
            if metadata is None:
                continue
            title = metadata.findtext(".//dc:title", default="", namespaces=ns).strip()
            description = metadata.findtext(
                ".//dc:description", default="", namespaces=ns
            ).strip()
            identifiers = [
                x.text.strip()
                for x in metadata.findall(".//dc:identifier", ns)
                if x.text
            ]
            url_value = next((x for x in identifiers if x.startswith("http")), "")
            combined = " ".join([title, description, " ".join(identifiers)])
            doi = self._extract_doi(combined)
            year = self._extract_year(combined)
            if not title or not url_value:
                continue
            if not self._is_article_like_item(title, url_value, doi, year):
                continue
            items.append(
                self._raw(
                    title=title,
                    url=url_value,
                    abstract=description,
                    full_text=combined,
                    doi=doi,
                    year=year,
                    journal="Revistas CSIC",
                )
            )
            if len(items) >= remaining:
                break
        token_node = root.find(".//oai:resumptionToken", ns)
        token = (
            token_node.text.strip()
            if token_node is not None and token_node.text
            else ""
        )
        return (items, token)


